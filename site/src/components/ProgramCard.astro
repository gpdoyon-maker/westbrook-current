---
import type { HelpProgram } from '../lib/help';
import { formatCheckedDate } from '../lib/help';

interface Props {
  program: HelpProgram;
  checked: string; // ISO date, for example 2026-10-14
}
const { program, checked } = Astro.props;
---
<details class={`card${program.last ? ' last' : ''}`}>
  <summary>
    <span class="card-tag">{program.tag}</span>
    <h3>{program.name}</h3>
    {program.chip && <span class={`chip ${program.chipKind === 'limit' ? '' : program.chipKind ?? ''}`.trim()}>{program.chip}</span>}
    {program.phone && program.phoneHref && <a class="btn" href={program.phoneHref}>Call {program.phone}</a>}
    <span class="card-more" aria-hidden="true"></span>
  </summary>
  <div class="card-body">
    <p>{program.summary}</p>
    {program.know && <p class="know">{program.know}</p>}
    <a class="btn alt" href={program.sourceUrl} target="_blank" rel="noopener noreferrer">Official page<span class="visually-hidden"> for {program.name} (opens in a new tab)</span> &#8599;</a>
    <p class="src-line">Source: {program.sourceLabel}</p>
    <p class="checked">Last checked {formatCheckedDate(checked)}</p>
  </div>
</details>
