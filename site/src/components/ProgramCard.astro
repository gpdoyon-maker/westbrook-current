---
import type { HelpProgram } from '../lib/help';
import { formatCheckedDate, linkPhones } from '../lib/help';

interface Props {
  program: HelpProgram;
  checked: string; // ISO date, for example 2026-10-14
}
const { program, checked } = Astro.props;
---
<article class={`prog-card${program.last ? ' last' : ''}`}>
  <span class="card-tag">{program.tag}</span>
  <h3>{program.name}</h3>
  {program.chip && <span class={`chip ${program.chipKind === 'limit' ? '' : program.chipKind ?? ''}`.trim()}>{program.chip}</span>}
  <p set:html={linkPhones(program.summary)} />
  {program.know && <p class="know" set:html={linkPhones(program.know)} />}
  <div class="card-actions">
    {program.phone && program.phoneHref && <a class="btn" href={program.phoneHref}>Call {program.phone}</a>}
    {program.email && <a class="btn alt" href={`mailto:${program.email}`}>{program.email}</a>}
    {program.more && <a class="btn alt" href={program.more.url}>{program.more.label} &#8594;</a>}
    <a class="btn alt ext" href={program.sourceUrl} target="_blank" rel="noopener noreferrer"><span>Official page &#8599;<span class="visually-hidden"> for {program.name}</span></span><span class="ext-note">(opens in a new tab)</span></a>
  </div>
  <p class="src-line">Source: {program.sourceLabel}</p>
  <p class="checked">Last checked {formatCheckedDate(checked)}</p>
</article>
