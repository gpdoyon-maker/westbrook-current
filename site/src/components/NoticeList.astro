---
import rawNotices from '../data/notices.json';
import { addDays, normalizeDate, normalizePosted, normalizeTime, nyToUtcMs } from '../lib/notice-time';

interface Props {
  kind: 'alerts' | 'notices';
  // Most notices to show at once, counted after expired ones are removed in the visitor's browser.
  limit?: number;
  // Open a notice in place, under its row, at every screen width (for pages with no details pane).
  inline?: boolean;
}

const { kind, limit, inline = false } = Astro.props;

type NoticeType = 'emergency' | 'parking' | 'delay' | 'general';
const LABELS: Record<NoticeType, string> = { emergency: 'EMERGENCY', parking: 'PARKING BAN', delay: 'ALERT', general: 'NOTICE' };
const ORDER: Record<NoticeType, number> = { emergency: 0, parking: 1, delay: 2, general: 3 };

// Accepts the sheet's Notice Type labels as well as the short names.
function typeOf(value: unknown): NoticeType {
  const text = String(value ?? '').toLowerCase();
  if (text.includes('emergency')) return 'emergency';
  if (text.includes('parking')) return 'parking';
  if (text.includes('delay') || text.includes('cancel') || text.includes('closure')) return 'delay';
  return 'general';
}

function officialUrl(value: unknown): URL | null {
  try {
    const url = new URL(String(value ?? '').trim());
    return url.protocol === 'https:' || url.protocol === 'http:' ? url : null;
  } catch {
    return null;
  }
}

// A record needs a headline, an official source link, and an expiry date. Anything
// missing one of those is dropped so nothing unsourced or never-expiring can appear.
const items = (rawNotices as unknown as Record<string, unknown>[])
  .filter((notice) => notice.status === undefined || String(notice.status).trim().toLowerCase() === 'active')
  .map((notice) => {
    const type = typeOf(notice.type);
    const link = officialUrl(notice.officialLink);
    const headline = String(notice.headline ?? '').trim();
    const expiresDate = normalizeDate(notice.expiresDate);
    const expiresTime = normalizeTime(notice.expiresTime);
    const showFrom = normalizeDate(notice.showFrom);
    if (!headline || !link || !expiresDate) return null;
    return {
      type,
      label: LABELS[type],
      headline,
      description: String(notice.description ?? '').trim(),
      href: link.href,
      host: link.hostname.replace(/^www\./, ''),
      posted: normalizePosted(notice.postedAt),
      expiresDate,
      expiresTime,
      showFromMs: showFrom ? nyToUtcMs(showFrom, '00:00') : 0,
      expiresMs: expiresTime ? nyToUtcMs(expiresDate, expiresTime) : nyToUtcMs(addDays(expiresDate, 1), '00:00'),
    };
  })
  .filter((notice): notice is NonNullable<typeof notice> => notice !== null)
  .filter((notice) => (kind === 'alerts' ? notice.type !== 'general' : notice.type === 'general'))
  .sort((a, b) => ORDER[a.type] - ORDER[b.type] || b.posted.localeCompare(a.posted) || a.expiresMs - b.expiresMs);
---
{items.length > 0 && kind === 'alerts' && (
  <div class="alert-stack" data-notice-stack hidden>
    {items.map((item) => (
      <section
        class={`alert alert-${item.type}`}
        aria-label={`${item.label.charAt(0)}${item.label.slice(1).toLowerCase()} alert`}
        hidden
        data-notice
        data-show-from-ms={item.showFromMs}
        data-expires-ms={item.expiresMs}
        data-posted={item.posted}
      >
        <div class="alert-inner">
          <p class="alert-meta">
            {item.type === 'emergency' || item.type === 'parking' ? (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2h8l6 6v8l-6 6H8l-6-6V8z"></path><path d="M12 7v6M12 16.5h.01"></path></svg>
            ) : (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l10 18H2z"></path><path d="M12 10v5M12 18h.01"></path></svg>
            )}
            <span>{item.label}</span>
            <span class="alert-posted" data-posted-label hidden></span>
          </p>
          <p class="alert-headline">{item.headline}</p>
          {item.description && <p class="alert-detail">{item.description}</p>}
          <a class="alert-source" href={item.href} target="_blank" rel="noopener noreferrer">Official source: {item.host} &rsaquo;</a>
        </div>
      </section>
    ))}
  </div>
)}

{items.length > 0 && kind === 'notices' && (
  <div class={`notice-stack${inline ? ' notice-inline' : ''}`} data-notice-stack data-limit={limit} hidden>
    {items.map((item) => (
      <div
        class="notice"
        hidden
        data-notice
        data-show-from-ms={item.showFromMs}
        data-expires-ms={item.expiresMs}
        data-title={item.headline}
        data-description={item.description}
        data-href={item.href}
        data-host={item.host}
        data-expires-date={item.expiresDate}
        data-expires-time={item.expiresTime}
      >
        <button class="notice-toggle" type="button" aria-expanded="false">
          <svg class="notice-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 8h.01"></path></svg>
          <span class="notice-title">{item.headline}</span>
          <span class="notice-arrow" aria-hidden="true">›</span>
        </button>
        <div class="notice-mobile-details mobile-details" aria-live="polite"></div>
      </div>
    ))}
  </div>
)}

<style>
  .alert-stack[hidden], .notice-stack[hidden], .alert[hidden], .notice[hidden], .alert-posted[hidden] { display: none; }

  .alert { padding: 12px 14px 4px; border-bottom: 2px solid var(--alert-edge); color: var(--alert-ink); background: var(--alert-bg); }
  .alert-delay { --alert-bg: #fff4d6; --alert-edge: #a47726; --alert-ink: #35280e; --alert-accent: #6b4a0a; }
  .alert-emergency, .alert-parking { --alert-bg: #fde8e6; --alert-edge: #b3261e; --alert-ink: #3d0f0b; --alert-accent: #8c1c13; }
  .alert-inner { width: min(1200px, 100%); margin: 0 auto; }
  .alert-meta { display: flex; align-items: center; gap: 6px; margin: 0; color: var(--alert-accent); font-size: 11px; font-weight: 800; letter-spacing: .06em; }
  .alert-posted { font-weight: 600; letter-spacing: 0; }
  .alert-headline { margin: 4px 0 0; font-size: 15px; font-weight: 800; line-height: 1.3; }
  .alert-emergency .alert-headline, .alert-parking .alert-headline { font-size: 16px; }
  .alert-detail { margin: 3px 0 0; font-size: 13px; line-height: 1.4; white-space: pre-line; }
  .alert-source { display: inline-flex; align-items: center; min-height: 44px; color: var(--alert-accent); font-size: 13px; font-weight: 700; }

  .notice-stack { display: grid; gap: 8px; padding: 10px 12px; }
  .notice { overflow: hidden; border: 1px solid #6fb0cb; border-left: 6px solid var(--blue); border-radius: 8px; color: var(--navy); background: #d3eaf5; box-shadow: 0 1px 3px #092c4320; }
  .notice-toggle { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px; padding: 8px 12px; border: 0; color: var(--navy); background: none; font-size: 13px; text-align: left; }
  .notice-toggle:focus-visible, .alert-source:focus-visible { outline: 2px solid var(--blue); outline-offset: -2px; }
  .notice-icon { flex: 0 0 auto; color: #0a5f80; }
  .notice-title { flex: 1; min-width: 0; font-weight: 700; }
  /* Same arrow as the event rows. Details open in the right-hand pane (desktop) or below the card (phone). */
  .notice-arrow { flex: 0 0 auto; margin-left: 12px; color: #6e8592; font-size: 23px; line-height: 1; }
  .notice-mobile-details { display: none; }

  @media (min-width: 721px) {
    .alert { padding-inline: 24px; }
  }
  @media (max-width: 720px) {
    .notice-arrow { margin-left: 4px; }
    .notice.is-open .notice-mobile-details { display: block; padding: 17px; border-top: 1px solid #6fb0cb; background: #fff; }
  }
</style>

<!-- Home page version: rows open in place at every width. Global because the details are built by the script below. -->
<style is:global>
  .notice-stack.notice-inline.notice-inline { padding: 0; }
  .notice-inline .notice-arrow { transition: transform .15s; }
  .notice-inline .notice.is-open .notice-arrow { transform: rotate(90deg); }
  .notice-inline .notice.is-open .notice-mobile-details { display: block; padding: 16px 18px 18px; border-top: 1px solid #6fb0cb; background: #fff; }
  .notice-inline .detail-category { margin: 0 0 6px; color: var(--blue); font-size: 11px; font-weight: 800; text-transform: uppercase; }
  .notice-inline .detail-title { margin: 0 0 12px; color: var(--navy); font-size: 19px; line-height: 1.25; }
  .notice-inline .detail-meta { display: grid; gap: 6px; margin: 0 0 12px; color: #294858; font-size: 14px; }
  .notice-inline .detail-meta p { margin: 0; overflow-wrap: anywhere; }
  .notice-inline .detail-description { margin: 12px 0; color: #294858; font-size: 15px; line-height: 1.6; white-space: pre-line; }
  .notice-inline .detail-actions { display: grid; margin-top: 14px; }
  .notice-inline .detail-link { display: block; padding: 12px 14px; border: 1px solid var(--blue); border-radius: 4px; color: #fff; background: var(--blue); font-size: 15px; font-weight: 800; text-align: center; text-decoration: none; }
</style>

<script>
  import { postedLabel } from '../lib/notice-time';

  // Visibility is decided in the visitor's browser so an alert or notice disappears
  // on time even if the page was built earlier. Anything unreadable stays hidden.
  function refreshNotices() {
    const now = Date.now();
    document.querySelectorAll<HTMLElement>('[data-notice]').forEach((item) => {
      const from = Number(item.dataset.showFromMs);
      const until = Number(item.dataset.expiresMs);
      const visible = now >= from && now < until;
      item.hidden = !visible;
      const posted = item.dataset.posted;
      const label = item.querySelector<HTMLElement>('[data-posted-label]');
      if (visible && posted && label) {
        label.textContent = `· ${postedLabel(posted, now)}`;
        label.hidden = false;
      }
    });
    // A stack with a limit shows only its first few visible items (already sorted, most important first).
    document.querySelectorAll<HTMLElement>('[data-notice-stack][data-limit]').forEach((stack) => {
      const max = Number(stack.dataset.limit);
      if (!Number.isFinite(max)) return;
      let shown = 0;
      stack.querySelectorAll<HTMLElement>('[data-notice]:not([hidden])').forEach((item) => {
        if (shown >= max) item.hidden = true;
        else shown += 1;
      });
    });
    document.querySelectorAll<HTMLElement>('[data-notice-stack]').forEach((stack) => {
      stack.hidden = !stack.querySelector('[data-notice]:not([hidden])');
    });
  }

  function closeNotices() {
    document.querySelectorAll<HTMLElement>('.notice.is-open').forEach((open) => {
      open.classList.remove('is-open');
      open.querySelector<HTMLElement>('.notice-toggle')?.setAttribute('aria-expanded', 'false');
      open.querySelector<HTMLElement>('.notice-mobile-details')?.replaceChildren();
    });
  }

  // Same building blocks and wording style as an event's details.
  function createNoticeDetails(notice: HTMLElement) {
    const content = document.createElement('div');
    const label = document.createElement('p');
    label.className = 'detail-category';
    label.textContent = 'Notice';
    const title = document.createElement('h2');
    title.className = 'detail-title';
    title.textContent = notice.dataset.title ?? '';
    content.append(label, title);

    const metadata = document.createElement('div');
    metadata.className = 'detail-meta';
    const lines: [string, string][] = [];
    const expiresDate = notice.dataset.expiresDate ?? '';
    if (expiresDate) {
      const date = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${expiresDate}T12:00:00Z`));
      const [hours, minutes] = (notice.dataset.expiresTime ?? '').split(':').map(Number);
      const time = Number.isFinite(hours) && Number.isFinite(minutes) ? ` at ${hours % 12 || 12}:${String(minutes).padStart(2, '0')} ${hours >= 12 ? 'PM' : 'AM'}` : '';
      lines.push(['Through', `${date}${time}`]);
    }
    if (notice.dataset.host) lines.push(['Source', notice.dataset.host]);
    for (const [name, value] of lines) {
      const line = document.createElement('p');
      const strong = document.createElement('strong');
      strong.textContent = `${name}: `;
      line.append(strong, document.createTextNode(value));
      metadata.append(line);
    }
    content.append(metadata);

    if (notice.dataset.description) {
      const description = document.createElement('p');
      description.className = 'detail-description';
      description.textContent = notice.dataset.description;
      content.append(description);
    }

    if (notice.dataset.href) {
      const actions = document.createElement('div');
      actions.className = 'detail-actions';
      const source = document.createElement('a');
      source.className = 'detail-link';
      source.href = notice.dataset.href;
      source.target = '_blank';
      source.rel = 'noopener noreferrer';
      source.textContent = 'Visit Official Source';
      actions.append(source);
      content.append(actions);
    }
    return content;
  }

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const toggle = target?.closest<HTMLButtonElement>('.notice-toggle') ?? null;
    if (!toggle) {
      // Choosing an event takes over the details pane, so a notice must not stay marked open.
      if (target?.closest('.event-row')) closeNotices();
      return;
    }
    const notice = toggle.closest<HTMLElement>('.notice');
    if (!notice) return;
    const wasOpen = notice.classList.contains('is-open');
    if (notice.closest('.notice-inline')) {
      // Home page: open or close right under the row. No details pane, and one open at a time.
      notice.closest('.notice-inline')?.querySelectorAll<HTMLElement>('.notice.is-open').forEach((open) => {
        open.classList.remove('is-open');
        open.querySelector<HTMLElement>('.notice-toggle')?.setAttribute('aria-expanded', 'false');
        open.querySelector<HTMLElement>('.notice-mobile-details')?.replaceChildren();
      });
      if (!wasOpen) {
        notice.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        notice.querySelector<HTMLElement>('.notice-mobile-details')?.replaceChildren(createNoticeDetails(notice));
      }
      return;
    }
    const detailPane = document.getElementById('detailPane');
    document.querySelectorAll('.event-entry.is-expanded').forEach((expanded) => expanded.classList.remove('is-expanded'));
    closeNotices();
    if (wasOpen) {
      detailPane?.replaceChildren(Object.assign(document.createElement('p'), { className: 'detail-empty', textContent: 'Choose an event' }));
      return;
    }
    const details = createNoticeDetails(notice);
    notice.classList.add('is-open');
    toggle.setAttribute('aria-expanded', 'true');
    detailPane?.replaceChildren(details.cloneNode(true));
    notice.querySelector<HTMLElement>('.notice-mobile-details')?.replaceChildren(details);
  });

  refreshNotices();
  window.setInterval(refreshNotices, 60_000);
</script>
