---
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatCheckedDate } from '../lib/help';
import '../styles/help.css';

const checked = '2026-11-09';
const city = 'https://westbrookmaine.gov';
const sos = 'https://www.maine.gov/sos/elections-voting/election-results-data';
const sourcePdf = `${city}/DocumentCenter/View/6439`;

// Westbrook's own vote counts, from the City Clerk's certified official results
// (signed by Ellis Ledoux, City Clerk, 11/04/2026). These are Westbrook's totals
// only -- for any race that spans more than Westbrook (every one of these except
// the unopposed/single-town seats), the actual winner is decided by the full
// district/county/state count, not by Westbrook alone.
//
// "incumbent" reflects who already held the seat going into this election,
// confirmed against official/legislative sources, not just the City's PDF.
//
// One addition error in the source PDF, present in both the unofficial and the
// official document: it lists Nangle's Total as blank/0, which doesn't match its
// own Ward 1-5 + Absentee columns (1,538 + 2,826). Shown here as 4,364, the
// correct sum.
//
// The official document spells two candidates' names differently than their own
// public/legislative records (prints "Reilly, Morgan J" and "Ducson, Jill C.");
// kept here as "Morgan Rielly" and "Jill Duson," their correct public spelling.
//
// Certification made a few small corrections to the unofficial count posted the
// day after the election: U.S. Senator (Collins 2,747 -> 3,047, Blank 144 -> 188),
// U.S. Representative (Pingree 7,095 -> 7,094), State Rep. District 126
// (Blank 31 -> 29), and Judge of Probate (Blank 1,922 -> 1,919). Every other race
// was unchanged by certification.
const races = [
  {
    office: 'U.S. Senator',
    sub: 'Ranked choice voting statewide &mdash; shown here is the 1st-choice count only.',
    multiTown: true,
    candidates: [
      { name: 'Susan Collins', party: 'R', votes: 3047, incumbent: true },
      { name: 'Troy D. Jackson', party: 'D', votes: 6505 },
    ],
    writeIns: 22,
    blank: 188,
    open: true,
  },
  {
    office: 'Governor',
    sub: 'Gov. Janet Mills is term-limited, so this is an open seat &mdash; no incumbent is running.',
    multiTown: true,
    candidates: [
      { name: 'Rick Bennett', party: 'I', votes: 726 },
      { name: 'Robert B. Charles', party: 'R', votes: 2215 },
      { name: 'Hannah M. Pingree', party: 'D', votes: 6700 },
    ],
    writeIns: 2,
    blank: 119,
    open: true,
  },
  {
    office: 'U.S. Representative to Congress (District 1)',
    multiTown: true,
    candidates: [
      { name: 'Chellie Pingree', party: 'D', votes: 7094, incumbent: true },
      { name: 'Ronald C. Russell', party: 'R', votes: 2475 },
    ],
    blank: 193,
  },
  {
    office: 'State Senator (District 26)',
    multiTown: true,
    candidates: [
      { name: 'Kenneth James Cianchette', party: 'R', votes: 1906 },
      { name: 'Timothy E. Nangle', party: 'D', votes: 4364, incumbent: true },
    ],
    blank: 169,
  },
  {
    office: 'State Senator (District 27)',
    multiTown: true,
    unopposed: true,
    candidates: [
      { name: 'Jill Duson', party: 'D', votes: 2676, incumbent: true },
    ],
    blank: 647,
  },
  {
    office: 'State Representative to the Legislature (District 126)',
    multiTown: true,
    candidates: [
      { name: 'Andrew Gattine', party: 'D', votes: 454, incumbent: true },
      { name: 'Ethan E. Mongue', party: 'R', votes: 206 },
    ],
    blank: 29,
  },
  {
    office: 'State Representative to the Legislature (District 127)',
    multiTown: true,
    unopposed: true,
    candidates: [
      { name: 'Morgan Rielly', party: 'D', votes: 3398, incumbent: true },
    ],
    blank: 716,
  },
  {
    office: 'State Representative to the Legislature (District 128)',
    multiTown: true,
    candidates: [
      { name: 'Lawrence P. McWilliams', party: 'R', votes: 1436 },
      { name: 'Suzanne M. Salisbury', party: 'D', votes: 3302, incumbent: true },
    ],
    blank: 221,
  },
  {
    office: 'Judge of Probate (Cumberland County)',
    multiTown: true,
    unopposed: true,
    candidates: [
      { name: 'Paul Aranson', votes: 7843, incumbent: true },
    ],
    blank: 1919,
  },
  {
    office: 'Sheriff (Cumberland County)',
    multiTown: true,
    unopposed: true,
    candidates: [
      { name: 'Kevin J. Joyce', votes: 8005, incumbent: true },
    ],
    blank: 1757,
  },
  {
    office: 'District Attorney (District 2)',
    multiTown: true,
    candidates: [
      { name: 'Stephanie Anderson', votes: 3241 },
      { name: 'Jacqueline A. Sartoris', votes: 5720, incumbent: true },
    ],
    blank: 801,
  },
  {
    office: 'County Commissioner (District 4)',
    multiTown: true,
    unopposed: true,
    candidates: [
      { name: 'Patricia A. Smith', votes: 7773, incumbent: true },
    ],
    blank: 1989,
  },
];
---
<SiteLayout
  title="Election Results (Official) | Westbrook Currents"
  description="Official, certified results for the November 3, 2026 general election in Westbrook, Maine, as certified by the City Clerk."
  currentPage="vote"
>
  <main class="help-wrap t-vote">
    <a class="help-back" href="/">&#8249; Home</a>
    <h1>Election Results</h1>
    <p class="help-sub">General Election &middot; Tuesday, November 3, 2026</p>

    <section class="vote-hero" aria-label="Official results certified">
      <small>Official results</small>
      <strong>The City has certified official results.</strong>
      <p>These are Westbrook's own vote counts, certified by City Clerk Ellis Ledoux on November 4, 2026. Certification made a few small corrections to the unofficial count posted the day after the election &mdash; nothing changed the outcome of any race.</p>
      <a class="btn" href={sourcePdf} target="_blank" rel="noopener noreferrer">City's official results (PDF)<span class="visually-hidden"> (opens in a new tab)</span> &#8599;</a>
    </section>

    <section class="help-box limit" aria-labelledby="howto-title">
      <h2 id="howto-title">How to read these</h2>
      <p>Every race below is Westbrook's vote count only. For races that cover more than Westbrook &mdash; Governor, U.S. Senate, U.S. House, State Senate, State House, and the Cumberland County races &mdash; the actual winner is decided by the full district, county, or statewide count, not by Westbrook alone. For that bigger picture, check the <a href={sos} target="_blank" rel="noopener noreferrer">Maine Secretary of State's election results<span class="visually-hidden"> (opens in a new tab)</span> &#8599;</a>.</p>
      <p class="fine"><strong>Incumbent</strong> means the candidate already held that seat going into this election. Races with only one name on the ballot are marked <strong>unopposed</strong>.</p>
      <p class="checked">Last checked {formatCheckedDate(checked)}</p>
    </section>

    {races.map((race) => (
      <details class="vote-sec" open={race.open}>
        <summary>
          {race.office}
          {race.unopposed && <span class="chip none">Unopposed</span>}
        </summary>
        <div class="vote-body">
          {race.sub && <p set:html={race.sub} />}
          <table class="dates results-table">
            <caption class="visually-hidden">{race.office} results for Westbrook</caption>
            <tbody>
              {race.candidates.map((c) => (
                <tr>
                  <th scope="row">
                    {c.name}{c.party && ` (${c.party})`}
                    {c.incumbent && <span class="chip info">Incumbent</span>}
                  </th>
                  <td>{c.votes.toLocaleString()}</td>
                </tr>
              ))}
              {race.writeIns && (
                <tr>
                  <th scope="row">Write-in candidates (combined)</th>
                  <td>{race.writeIns.toLocaleString()}</td>
                </tr>
              )}
              <tr>
                <th scope="row">Blank</th>
                <td>{race.blank.toLocaleString()}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </details>
    ))}

    <aside class="disclaimer" aria-label="About this page">
      <strong>Thank you to everyone who voted, and to the election workers.</strong> Westbrook Currents is independent and is not run by the City of Westbrook.
    </aside>
  </main>

  <style is:global>
    .results-table th { width: auto; }
    .results-table .chip { margin-left: 8px; vertical-align: middle; }
  </style>
</SiteLayout>
