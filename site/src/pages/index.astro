---
import SiteLayout from '../layouts/SiteLayout.astro';
import events from '../data/events.json';

const categoryColors: Record<string, string> = {
  'Arts & music': '#8b6fb3',
  'Community & civic': '#3b6e91',
  'Classes & learning': '#a47726',
  'Family & kids': '#c0765a',
  'Food & drink': '#a14e4e',
  'Health & wellness': '#347c60',
  'Markets & shopping': '#8c7a4e',
  'Outdoors & nature': '#4b784b',
  'Sports & recreation': '#3e7ca6',
  Seniors: '#71627f',
  'Faith & spirituality': '#896b95',
  Other: '#6e6e6e',
};

const formatDisplayTime = (value: string | null | undefined) => {
  if (!value || typeof value !== 'string') return '';
  const trimmedValue = value.trim();
  if (!trimmedValue) return '';
  const [hours, minutes] = trimmedValue.split(':').map(Number);
  if (Number.isNaN(hours) || Number.isNaN(minutes)) return '';
  const period = hours >= 12 ? 'PM' : 'AM';
  const hour = hours % 12 || 12;
  return `${hour}:${String(minutes).padStart(2, '0')} ${period}`;
};

const getSortValue = (value: string | null | undefined) => {
  if (!value || typeof value !== 'string') return Number.MAX_SAFE_INTEGER;
  const trimmedValue = value.trim();
  if (!trimmedValue) return Number.MAX_SAFE_INTEGER;
  const [hours, minutes] = trimmedValue.split(':').map(Number);
  if (Number.isNaN(hours) || Number.isNaN(minutes)) return Number.MAX_SAFE_INTEGER;
  return hours * 60 + minutes;
};

const eventRecords = events
  .map((event, index) => ({
    ...event,
    index,
    displayStartTime: formatDisplayTime(event.startTime),
    sortStartTime: getSortValue(event.startTime),
  }))
  .sort((a, b) => a.sortStartTime - b.sortStartTime || a.title.localeCompare(b.title));

const newYorkTimeZone = 'America/New_York';
const getNewYorkOffsetMinutes = (timestamp: number) => {
  const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', {
    timeZone: newYorkTimeZone,
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23',
  }).formatToParts(new Date(timestamp)).map(({ type, value }) => [type, value]));
  const localAsUtc = Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day), Number(parts.hour), Number(parts.minute), Number(parts.second));
  return (localAsUtc - timestamp) / 60_000;
};
const formatSchemaStartDate = (date: string, startTime?: string) => {
  if (!startTime) return date;
  const match = /^(\d{2}):(\d{2})$/.exec(startTime);
  if (!match) return date;
  const hours = Number(match[1]);
  const minutes = Number(match[2]);
  if (hours > 23 || minutes > 59) return date;
  const [year, month, day] = date.split('-').map(Number);
  const wallTimeAsUtc = Date.UTC(year, month - 1, day, hours, minutes);
  let timestamp = wallTimeAsUtc;
  for (let attempt = 0; attempt < 3; attempt += 1) {
    timestamp = wallTimeAsUtc - getNewYorkOffsetMinutes(timestamp) * 60_000;
  }
  const offsetMinutes = getNewYorkOffsetMinutes(timestamp);
  const sign = offsetMinutes < 0 ? '-' : '+';
  const absoluteOffset = Math.abs(offsetMinutes);
  const offset = `${sign}${String(Math.floor(absoluteOffset / 60)).padStart(2, '0')}:${String(absoluteOffset % 60).padStart(2, '0')}`;
  return `${date}T${startTime}:00${offset}`;
};
const structuredEvents = events
  .filter((event) => typeof event.title === 'string' && event.title.trim() && typeof event.date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(event.date))
  .map((event) => ({
    '@type': 'Event',
    name: event.title,
    startDate: formatSchemaStartDate(event.date, event.startTime),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      ...(event.venue ? { name: event.venue } : {}),
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Westbrook',
        addressRegion: 'ME',
        addressCountry: 'US',
      },
    },
    description: event.description ?? '',
    ...(event.sourceLink ? { url: event.sourceLink } : {}),
    ...(event.admission === 'free' ? { isAccessibleForFree: true } : {}),
  }));
const eventJsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': structuredEvents })
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
const categories = [...new Set(events.map((event) => event.category))].sort((a, b) => a.localeCompare(b));
const monthKeys = [...new Set(events.map((event) => event.date.slice(0, 7)))].sort();
const months = monthKeys.map((key) => {
  const date = new Date(`${key}-01T12:00:00Z`);
  const monthLabel = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
  const days = [...new Set(events.filter((event) => event.date.startsWith(key)).map((event) => event.date))].sort().map((day) => ({
    date: day,
    label: new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(new Date(`${day}T12:00:00Z`)),
    events: eventRecords.filter((event) => event.date === day).sort((a, b) => a.sortStartTime - b.sortStartTime),
  }));
  return { key, label: monthLabel, days };
});
---

<SiteLayout title="Westbrook, Maine Events Calendar | Westbrook Currents" description="Find community events in Westbrook, Maine, including free, family, civic, arts, and more.">
  <script type="application/ld+json" set:html={eventJsonLd}></script>
  <main class="events-page">
    <h1 class="visually-hidden">Westbrook, Maine Events Calendar</h1>
    <section class="controls-wrapper" aria-label="Event filters">
      <div class="controls-container">
        <label class="visually-hidden" for="monthJump">Jump to month</label>
        <select id="monthJump" class="filter-control">
          <option value="">Month...</option>
          {months.map((month) => <option value={month.key}>{month.label}</option>)}
        </select>
        <label class="visually-hidden" for="searchInput">Search events</label>
        <input id="searchInput" class="filter-control search-input" type="search" placeholder="Search events" autocomplete="off" />
      </div>
      <div class="filter-chip-row" aria-label="Filter events">
        <button class="filter-chip category-chip is-active" type="button" data-category-filter="" aria-pressed="true">All categories</button>
        {categories.map((category) => (
          <button class="filter-chip category-chip" type="button" data-category-filter={category} aria-pressed="false">{category}</button>
        ))}
        <button class="filter-chip featured-chip" id="featuredFilter" type="button" aria-pressed="false"><span aria-hidden="true">★</span> Featured</button>
      </div>
    </section>

    <div class="main-layout">
      <div class="list-pane" id="eventList" aria-label="Events">
        <p class="featured-empty" id="featuredEmptyMessage" role="status" hidden></p>
        {months.map((month) => (
          <section class="month-section" id={`month-${month.key}`} data-month={month.key}>
            <h2 class="month-header">{month.label}</h2>
            {month.days.map((day) => (
              <section class="date-group" data-date={day.date}>
                <h3 class="date-header">
                  <span>{day.label}</span>
                  <span class="today-badge" hidden>TODAY</span>
                </h3>
                {day.events.map((event) => (
                  <div class="event-entry">
                    <button
                      class:list={['event-row', event.highlight === true && 'is-featured']}
                      type="button"
                      data-event-index={event.index}
                      data-category={event.category}
                      data-featured={event.highlight === true ? 'true' : 'false'}
                      data-search={`${event.title} ${event.venue} ${event.category} ${event.description}`.toLocaleLowerCase()}
                      style={`--event-accent:${categoryColors[event.category] ?? '#6e6e6e'}`}
                    >
                      <span class="row-time">{event.displayStartTime}</span>
                      <span class="row-content">
                        {event.highlight === true && <span class="featured-badge"><span aria-hidden="true">★</span> Featured</span>}
                        <span class="row-title">{event.title}</span>
                        <span class="row-meta">{event.venue || 'Venue not listed'}</span>
                        <span class="row-category"><span class="cat-dot"></span>{event.category}{event.admission === 'free' && <span class="free-label">FREE</span>}</span>
                      </span>
                      <span class="row-arrow" aria-hidden="true">›</span>
                    </button>
                    <div class="mobile-details" aria-live="polite"></div>
                  </div>
                ))}
              </section>
            ))}
          </section>
        ))}
      </div>
      <aside class="detail-pane" id="detailPane" aria-live="polite" aria-label="Event details">
        <p class="detail-empty">Choose an event</p>
      </aside>
    </div>
  </main>

  <style>
    .events-page { min-height: 70vh; }
    .controls-wrapper { position: sticky; z-index: 8; top: 86px; padding: 12px 20px; border-bottom: 1px solid var(--line); background: #fff; box-shadow: 0 3px 10px #092c4310; }
    .controls-container { display: grid; grid-template-columns: minmax(160px, 1fr) minmax(180px, 1fr) minmax(220px, 2fr); gap: 10px; width: min(1200px, 100%); margin: 0 auto; }
    .filter-chip-row { display: flex; flex-wrap: wrap; gap: 8px; width: min(1200px, 100%); margin: 10px auto 0; }
    .filter-chip { min-height: 34px; padding: 6px 11px; border: 1px solid #b8c9d2; border-radius: 18px; color: #294858; background: #fff; font-size: 12px; font-weight: 700; white-space: nowrap; }
    .filter-chip:hover, .filter-chip:focus-visible { border-color: var(--blue); }
    .filter-chip.is-active { border-color: var(--blue); color: #fff; background: var(--blue); }
    .featured-chip { color: #70500e; background: #fff8e6; }
    .featured-chip.is-active { border-color: #a47726; color: #35280e; background: #f3d98f; }
    .featured-chip span { margin-right: 3px; }
    .featured-empty { margin: 0; padding: 14px 22px; color: #70500e; background: #fff8e6; font-size: 14px; font-weight: 700; }
    .filter-control { width: 100%; min-height: 42px; padding: 8px 11px; border: 1px solid #b8c9d2; border-radius: 4px; color: #16394d; background: #fff; }
    .search-input { cursor: text; }
    .main-layout { display: flex; width: min(1200px, 100%); min-height: calc(100vh - 140px); margin: 0 auto; }
    .list-pane { flex: 1 1 auto; min-width: 0; background: var(--mist); }
    .month-header { position: sticky; z-index: 4; top: 152px; margin: 0; padding: 12px 22px; color: #16445c; background: #e4edf1; font-size: 12px; font-weight: 800; text-transform: uppercase; }
    .date-group[hidden], .month-section[hidden], .event-entry[hidden] { display: none; }
    .date-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0; padding: 20px 22px 8px; color: #08688e; font-size: 12px; font-weight: 800; text-transform: uppercase; }
    .today-badge { flex: 0 0 auto; padding: 4px 8px; border-radius: 3px; color: #fff; background: #d64a46; font-size: 10px; }
    .event-entry { margin: 0 12px 8px; }
    .event-row { display: flex; align-items: center; width: 100%; min-height: 88px; padding: 14px; border: 1px solid var(--line); border-left: 4px solid var(--event-accent); border-radius: 4px; color: inherit; background: #fff; text-align: left; transition: border-color 120ms ease, background-color 120ms ease; }
    .event-row:hover, .event-row:focus-visible { border-color: var(--event-accent); background: #fbfdfe; }
    .event-row:focus-visible { outline: 3px solid #42bfe855; outline-offset: 2px; }
    .event-row.is-featured { border-left-width: 8px; background: #fff8e6; }
    .event-row.is-featured:hover, .event-row.is-featured:focus-visible { background: #fff2cf; }
    .row-time { flex: 0 0 82px; color: #28495c; font-size: 12px; font-weight: 800; }
    .row-content { display: grid; flex: 1; min-width: 0; gap: 4px; }
    .featured-badge { justify-self: start; padding: 3px 7px; border-radius: 3px; color: #59410d; background: #f3d98f; font-size: 10px; font-weight: 800; line-height: 1.2; }
    .featured-badge span { margin-right: 2px; }
    .row-title { font-size: 16px; font-weight: 800; line-height: 1.25; }
    .row-meta { overflow-wrap: anywhere; color: var(--muted); font-size: 13px; }
    .row-category { display: flex; align-items: center; gap: 6px; color: #435b69; font-size: 10px; font-weight: 800; text-transform: uppercase; }
    .cat-dot { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 50%; background: var(--event-accent); }
    .free-label { margin-left: 5px; color: #24764d; }
    .row-arrow { margin-left: 12px; color: #6e8592; font-size: 23px; }
    .detail-pane { position: sticky; top: 152px; flex: 0 0 390px; align-self: flex-start; height: calc(100vh - 152px); min-height: 400px; overflow-y: auto; padding: 26px; border-left: 1px solid var(--line); background: #fff; }
    :global(.detail-empty) { margin-top: 8px; color: #71838d; font-size: 14px; }
    :global(.detail-category) { margin: 0 0 10px; color: var(--blue); font-size: 11px; font-weight: 800; text-transform: uppercase; }
    :global(.detail-featured-badge) { display: inline-block; margin: 0 0 10px; padding: 4px 8px; border-radius: 3px; color: #59410d; background: #f3d98f; font-size: 11px; font-weight: 800; }
    :global(.detail-title) { margin: 0 0 22px; color: var(--navy); font-size: 25px; line-height: 1.15; }
    :global(.detail-meta) { display: grid; gap: 10px; margin: 0 0 24px; color: #294858; font-size: 14px; }
    :global(.detail-meta p) { margin: 0; overflow-wrap: anywhere; }
    :global(.detail-description) { margin: 22px 0; color: var(--muted); font-size: 15px; line-height: 1.65; white-space: pre-line; }
    :global(.detail-actions) { display: grid; gap: 10px; margin-top: 26px; }
    :global(.detail-link) { display: block; width: 100%; padding: 12px 14px; border: 1px solid var(--blue); border-radius: 4px; color: #fff; background: var(--blue); font: inherit; font-size: 14px; font-weight: 800; text-align: center; text-decoration: none; cursor: pointer; }
    :global(.detail-link.secondary) { color: #16445c; background: #fff; }
    :global(.detail-link:hover) { filter: brightness(.94); }
    .mobile-details { display: none; }
    .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; clip-path: inset(50%); }
    @media (max-width: 720px) {
      .controls-wrapper { position: sticky; top: 0; padding: 10px 12px; }
      .controls-container { grid-template-columns: minmax(0, 1fr); gap: 8px; }
      .search-input { grid-column: 1 / -1; }
      .filter-chip-row { flex-wrap: nowrap; overflow-x: auto; padding: 1px 0 6px; overscroll-behavior-x: contain; scrollbar-width: thin; }
      .filter-chip { flex: 0 0 auto; }
      .main-layout { display: block; }
      .month-header { top: 0; }
      .detail-pane { display: none; }
      .date-header { padding: 18px 14px 8px; }
      .event-entry { margin: 0 8px 8px; }
      .event-row { min-height: 84px; padding: 11px; }
      .row-time { flex-basis: 70px; font-size: 11px; }
      .row-title { font-size: 14px; }
      .row-meta { font-size: 12px; }
      .row-arrow { margin-left: 4px; }
      .event-entry.is-expanded .event-row { border-color: var(--event-accent); border-radius: 4px 4px 0 0; }
      .event-entry.is-expanded .mobile-details { display: block; padding: 17px; border: 1px solid var(--line); border-top: 0; background: #fff; }
      :global(.mobile-details .detail-title) { font-size: 21px; }
    }
  </style>

  <script>
    import eventRecords from '../data/events.json';

    const monthJump = document.querySelector<HTMLSelectElement>('#monthJump');
    const searchInput = document.querySelector<HTMLInputElement>('#searchInput');
    const detailPane = document.querySelector<HTMLElement>('#detailPane');
    const featuredFilter = document.querySelector<HTMLButtonElement>('#featuredFilter');
    const featuredEmptyMessage = document.querySelector<HTMLElement>('#featuredEmptyMessage');
    const categoryChips = document.querySelectorAll<HTMLButtonElement>('.category-chip');
    let selectedCategory = '';
    let featuredOnly = false;

    function formatTime(value) {
      if (!value || typeof value !== 'string') return '';
      const trimmedValue = value.trim();
      if (!trimmedValue) return '';
      const [hours, minutes] = trimmedValue.split(':').map(Number);
      if (Number.isNaN(hours) || Number.isNaN(minutes)) return '';
      const period = hours >= 12 ? 'PM' : 'AM';
      const hour = hours % 12 || 12;
      return `${hour}:${String(minutes).padStart(2, '0')} ${period}`;
    }

    function cleanDescription(value) {
      return String(value ?? '')
        .replace(/\[(?:Visit Event Website|Add to Google Calendar)\]\([^)]*\)/gi, '')
        .replace(/\n{3,}/g, '\n\n')
        .trim();
    }

    function safeEventUrl(value) {
      if (!value || typeof value !== 'string') return '';
      try {
        const url = new URL(value);
        return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : '';
      } catch {
        return '';
      }
    }

    function eventDetailsText(event) {
      const description = cleanDescription(event.description);
      const eventUrl = safeEventUrl(event.sourceLink);
      return [description, eventUrl ? `Event link: ${eventUrl}` : ''].filter(Boolean).join('\n\n');
    }

    function localDateTimeToUtc(date, time) {
      const [year, month, day] = date.split('-').map(Number);
      const [hours, minutes] = time.split(':').map(Number);
      const targetWallTime = Date.UTC(year, month - 1, day, hours, minutes);
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hourCycle: 'h23',
      });
      let timestamp = targetWallTime;
      for (let attempt = 0; attempt < 2; attempt += 1) {
        const parts = Object.fromEntries(formatter.formatToParts(new Date(timestamp)).map(({ type, value }) => [type, value]));
        const formattedWallTime = Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day), Number(parts.hour), Number(parts.minute), Number(parts.second));
        timestamp += targetWallTime - formattedWallTime;
      }
      return new Date(timestamp);
    }

    function googleCalendarLink(event) {
      const date = event.date.replaceAll('-', '');
      let dates;
      if (event.startTime) {
        const start = localDateTimeToUtc(event.date, event.startTime);
        const end = new Date(start.getTime() + 60 * 60 * 1000);
        const formatLocal = (value) => {
          const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', {
            timeZone: 'America/New_York',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            hourCycle: 'h23',
          }).formatToParts(value).map(({ type, value: partValue }) => [type, partValue]));
          return `${parts.year}${parts.month}${parts.day}T${parts.hour}${parts.minute}00`;
        };
        dates = `${formatLocal(start)}/${formatLocal(end)}`;
      } else {
        const nextDay = new Date(`${event.date}T00:00:00Z`);
        nextDay.setUTCDate(nextDay.getUTCDate() + 1);
        dates = `${date}/${nextDay.toISOString().slice(0, 10).replaceAll('-', '')}`;
      }
      const query = new URLSearchParams({
        action: 'TEMPLATE',
        text: String(event.title ?? ''),
        dates,
        ctz: 'America/New_York',
        details: eventDetailsText(event),
        location: String(event.venue ?? ''),
      });
      return `https://calendar.google.com/calendar/render?${query}`;
    }

    function escapeICSText(value) {
      return String(value ?? '')
        .replace(/\\/g, '\\\\')
        .replace(/\r?\n/g, '\\n')
        .replace(/,/g, '\\,')
        .replace(/;/g, '\\;');
    }

    function createICS(event) {
      const date = event.date.replaceAll('-', '');
      let timeFields;
      if (event.startTime) {
        const start = localDateTimeToUtc(event.date, event.startTime);
        const end = new Date(start.getTime() + 60 * 60 * 1000);
        const formatUtc = (value) => value.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');
        timeFields = `DTSTART:${formatUtc(start)}\r\nDTEND:${formatUtc(end)}`;
      } else {
        const nextDay = new Date(`${event.date}T00:00:00Z`);
        nextDay.setUTCDate(nextDay.getUTCDate() + 1);
        timeFields = `DTSTART;VALUE=DATE:${date}\r\nDTEND;VALUE=DATE:${nextDay.toISOString().slice(0, 10).replaceAll('-', '')}`;
      }
      const eventUrl = safeEventUrl(event.sourceLink);
      const description = eventDetailsText(event);
      const uid = globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}@westbrookcurrents.com`;
      return [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Westbrook Currents//Events//EN',
        'CALSCALE:GREGORIAN',
        'X-WR-TIMEZONE:America/New_York',
        'BEGIN:VEVENT',
        `UID:${uid}`,
        `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z')}`,
        timeFields,
        `SUMMARY:${escapeICSText(event.title)}`,
        `LOCATION:${escapeICSText(event.venue)}`,
        `DESCRIPTION:${escapeICSText(description)}`,
        ...(eventUrl ? [`URL:${eventUrl}`] : []),
        'END:VEVENT',
        'END:VCALENDAR',
        '',
      ].join('\r\n');
    }

    function downloadCalendarFile(event) {
      const blob = new Blob([createICS(event)], { type: 'text/calendar;charset=utf-8' });
      const objectUrl = URL.createObjectURL(blob);
      const download = document.createElement('a');
      download.href = objectUrl;
      download.download = `${event.date}-${String(event.title ?? 'event').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'event'}.ics`;
      document.body.append(download);
      download.click();
      download.remove();
      window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
    }

    function createDetails(event, eventIndex) {
      const content = document.createElement('div');
      const category = document.createElement('p');
      category.className = 'detail-category';
      category.textContent = `${event.category} · ${event.admission === 'free' ? 'Free' : 'Paid'}`;
      content.append(category);

      if (event.highlight === true) {
        const featuredBadge = document.createElement('p');
        featuredBadge.className = 'detail-featured-badge';
        featuredBadge.textContent = '★ Featured';
        content.append(featuredBadge);
      }

      const title = document.createElement('h2');
      title.className = 'detail-title';
      title.textContent = event.title;
      content.append(title);

      const metadata = document.createElement('div');
      metadata.className = 'detail-meta';
      const timeText = event.startTime ? formatTime(event.startTime) : '';
      const details = [
        ['Venue', event.venue || 'Venue not listed'],
        ['Date', new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${event.date}T12:00:00Z`))],
      ];
      if (timeText) {
        details.push(['Time', timeText]);
      }
      for (const [label, value] of details) {
        const line = document.createElement('p');
        const strong = document.createElement('strong');
        strong.textContent = `${label}: `;
        line.append(strong, document.createTextNode(value));
        metadata.append(line);
      }
      content.append(metadata);

      const descriptionText = cleanDescription(event.description);
      if (descriptionText) {
        const description = document.createElement('p');
        description.className = 'detail-description';
        description.textContent = descriptionText;
        content.append(description);
      }

      const actions = document.createElement('div');
      actions.className = 'detail-actions';
      const sourceHref = safeEventUrl(event.sourceLink);
      if (sourceHref) {
        const source = document.createElement('a');
        source.className = 'detail-link';
        source.href = sourceHref;
        source.target = '_blank';
        source.rel = 'noopener noreferrer';
        source.textContent = 'Visit Event Website';
        actions.append(source);
      }

      const googleCalendar = document.createElement('a');
      googleCalendar.className = 'detail-link secondary';
      googleCalendar.href = googleCalendarLink(event);
      googleCalendar.target = '_blank';
      googleCalendar.rel = 'noopener noreferrer';
      googleCalendar.textContent = 'Add to Google Calendar';
      actions.append(googleCalendar);

      const appleCalendar = document.createElement('button');
      appleCalendar.className = 'detail-link secondary';
      appleCalendar.classList.add('download-calendar-button');
      appleCalendar.dataset.eventIndex = String(eventIndex);
      appleCalendar.type = 'button';
      appleCalendar.textContent = 'Add to Apple Calendar';
      actions.append(appleCalendar);
      content.append(actions);
      return content;
    }

    function applyFilters() {
      const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
      document.querySelectorAll<HTMLElement>('.event-entry').forEach((entry) => {
        const button = entry.querySelector<HTMLButtonElement>('.event-row');
        const matchesText = button?.dataset.search?.includes(query) ?? false;
        const matchesCategory = !selectedCategory || button?.dataset.category === selectedCategory;
        const matchesFeatured = !featuredOnly || button?.dataset.featured === 'true';
        entry.hidden = !(matchesText && matchesCategory && matchesFeatured);
      });
      document.querySelectorAll<HTMLElement>('.date-group').forEach((group) => {
        group.hidden = !group.querySelector('.event-entry:not([hidden])');
      });
      document.querySelectorAll<HTMLElement>('.month-section').forEach((month) => {
        month.hidden = !month.querySelector('.date-group:not([hidden])');
      });

      const monthKey = monthJump?.value || `${new Date().getFullYear()}-${String(new Date().getMonth() + 1).padStart(2, '0')}`;
      const selectedMonth = document.querySelector<HTMLElement>(`.month-section[data-month="${monthKey}"]`);
      const selectedMonthLabel = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${monthKey}-01T12:00:00Z`));
      const hasFeatured = selectedMonth?.querySelector('.event-entry:not([hidden]) .event-row[data-featured="true"]');
      if (featuredEmptyMessage) {
        featuredEmptyMessage.hidden = !featuredOnly || Boolean(hasFeatured);
        featuredEmptyMessage.textContent = `No featured events match your filters for ${selectedMonthLabel}.`;
      }
    }

    const now = new Date();
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    document.querySelectorAll<HTMLElement>('.date-group').forEach((group) => {
      const badge = group.querySelector<HTMLElement>('.today-badge');
      if (group.dataset.date === today && badge) badge.hidden = false;
    });

    monthJump?.addEventListener('change', () => {
      const month = monthJump.value;
      if (month) document.querySelector(`#month-${month}`)?.scrollIntoView({ behavior: 'smooth' });
      applyFilters();
    });
    categoryChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        selectedCategory = chip.dataset.categoryFilter ?? '';
        categoryChips.forEach((categoryChip) => {
          const isActive = categoryChip === chip;
          categoryChip.classList.toggle('is-active', isActive);
          categoryChip.setAttribute('aria-pressed', String(isActive));
        });
        applyFilters();
      });
    });
    featuredFilter?.addEventListener('click', () => {
      featuredOnly = !featuredOnly;
      featuredFilter.classList.toggle('is-active', featuredOnly);
      featuredFilter.setAttribute('aria-pressed', String(featuredOnly));
      applyFilters();
    });
    searchInput?.addEventListener('input', applyFilters);

    document.addEventListener('click', (clickEvent) => {
      const target = clickEvent.target instanceof Element
        ? clickEvent.target.closest<HTMLButtonElement>('.download-calendar-button')
        : null;
      const event = target ? eventRecords[Number(target.dataset.eventIndex)] : null;
      if (event) downloadCalendarFile(event);
    });

    document.querySelectorAll<HTMLButtonElement>('.event-row').forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number(button.dataset.eventIndex);
        const event = eventRecords[index];
        const entry = button.closest<HTMLElement>('.event-entry');
        const wasExpanded = entry?.classList.contains('is-expanded') ?? false;
        document.querySelectorAll('.event-entry.is-expanded').forEach((expanded) => expanded.classList.remove('is-expanded'));
        if (wasExpanded) {
          detailPane?.replaceChildren(Object.assign(document.createElement('p'), { className: 'detail-empty', textContent: 'Choose an event' }));
          return;
        }
        const details = createDetails(event, index);
        detailPane?.replaceChildren(details.cloneNode(true));
        entry?.classList.add('is-expanded');
        entry?.querySelector<HTMLElement>('.mobile-details')?.replaceChildren(details);
      });
    });
  </script>
</SiteLayout>
