---
import SiteLayout from '../../layouts/SiteLayout.astro';
import meetings from '../../data/tldw-meetings.json';
import '../../styles/tldw.css';
---
<SiteLayout
  title="TL;DW! City Council Meeting Summaries | Westbrook Currents"
  description="Quick, honest summaries of Westbrook City Council meetings — what was decided, what got heated, and exactly where to watch it yourself."
  currentPage="tldw"
>
  <main class="tldw-wrap">
    <a class="help-back" href="/">&#8249; Home</a>
    <h1>TL;DW!</h1>
    <p class="tldw-tagline">(That's &ldquo;too long; didn't watch.&rdquo; You already knew that.)</p>

    <div class="tldw-intro">
      <p>A City Council meeting can run two hours or more, and not everyone can spare that much time &mdash; even though what gets decided in that room touches your taxes, your streets, your parks. These summaries are here to help: a quick read on what came up and what was decided, so you can judge for yourself what's worth your time.</p>
      <p>Think of each one as a guide, <b>not a substitute</b> for the meeting itself. Use it to find the parts that matter most to you, then jump to the video and watch those parts directly.</p>
      <p class="sign">&mdash; Gerry</p>
    </div>

    <div class="tldw-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color:#7c8a99"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="tldw-search-input" placeholder='Search meetings — try "data center" or "Saccarappa"…' aria-label="Search meeting summaries">
    </div>
    <p class="tldw-search-note">Matches a meeting's title, brief summary, and topic tags.</p>

    <p class="tldw-list-label">All meetings</p>

    <div id="tldw-list" style="display:flex; flex-direction:column; gap:14px;">
      {meetings.map((m) => (
        <a
          class="meeting-card"
          href={`/tldw/${m.slug}`}
          data-search={[m.title, m.blurb, ...m.tags].join(' ').toLowerCase()}
        >
          <div class="mc-top">
            <span class="mc-date">{m.dateLabel} &middot; {m.type}</span>
            {m.hot && <span class="hot-badge">&#128293; {m.hotNote}</span>}
          </div>
          <strong>{m.title}</strong>
          <span class="blurb">{m.blurb}</span>
          <div class="tldw-tags">
            {m.tags.map((tag) => <span class="tldw-tag">{tag}</span>)}
          </div>
          <span class="mc-go">Read the TL;DW! &#8594;</span>
        </a>
      ))}
    </div>

    <p id="tldw-empty" class="tldw-empty">No meetings match that search.</p>

    <div class="more-soon">More meetings added as summaries are finished.</div>

    <div class="disclaimer">
      <strong>Not a replacement for watching.</strong> Summarizing necessarily condenses and selects. For complete context and nuance, watch the full meeting video &mdash; the link is always right there when you want it.
    </div>
  </main>

  <script>
    const input = document.querySelector<HTMLInputElement>('#tldw-search-input');
    const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('#tldw-list .meeting-card'));
    const empty = document.querySelector<HTMLElement>('#tldw-empty');

    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const match = !q || (card.dataset.search ?? '').includes(q);
        card.style.display = match ? '' : 'none';
        if (match) visible += 1;
      });
      empty?.classList.toggle('show', visible === 0);
    });
  </script>
</SiteLayout>
