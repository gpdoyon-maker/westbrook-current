---
import SiteLayout from '../../layouts/SiteLayout.astro';
import meetings from '../../data/tldw-meetings.json';
import '../../styles/tldw.css';

const categories = ['Regular Meeting', 'Special Meeting', 'Committee of the Whole', 'Planning Board'];
const topicList = ['Budget & Taxes', 'Zoning & Development', 'Housing', 'Ordinances', 'Infrastructure', 'Transit & Transportation', 'Public Safety', 'Parks & Recreation', 'Personnel', 'General Assistance'];

const categoryCounts: Record<string, number> = {};
categories.forEach((c) => { categoryCounts[c] = meetings.filter((m: any) => m.category === c).length; });

// Meetings already come newest-first out of the data file; just bucket them by month, preserving order.
const monthGroups: { month: string; items: any[] }[] = [];
for (const m of meetings as any[]) {
  const last = monthGroups[monthGroups.length - 1];
  if (last && last.month === m.month) {
    last.items.push(m);
  } else {
    monthGroups.push({ month: m.month, items: [m] });
  }
}

function cardHref(m: any) {
  return m.slug === '2026-10-19-special-meeting' ? `/tldw/${m.slug}` : m.pdfHref;
}
function cardCta(m: any) {
  return m.slug === '2026-10-19-special-meeting' ? 'Read the TL;DW! →' : 'Read the full summary (PDF) →';
}
---
<SiteLayout
  title="TL;DW! City Council Meeting Summaries | Westbrook Currents"
  description="Quick, honest summaries of Westbrook City Council meetings — what was decided, what got heated, and exactly where to watch it yourself."
  currentPage="tldw"
>
  <main class="tldw-wrap">
    <a class="help-back" href="/">&#8249; Home</a>

    <div class="tldw-head">
      <h1>TL;DW!</h1>
      <span class="tldw-tagline">Too Long; Didn&rsquo;t Watch &mdash; but you knew that.</span>
    </div>

    <div class="tldw-intro">
      <p>City Council, Committee of the Whole, and Planning Board meetings run two hours or more, and not everyone can spare that much time &mdash; even though what gets decided in that room touches your taxes, your streets, your parks. These summaries are here to help: a quick read on what came up and what was decided, so you can judge for yourself what&rsquo;s worth your time.</p>
      <p>Think of each one as a guide, <b>not a substitute</b> for the meeting itself. Use it to find the parts that matter most to you, then jump to the video and watch those parts directly.</p>
      <p class="sign">&mdash; Gerry</p>
    </div>

    <div class="tldw-filter-card">
      <label for="tldw-search-input" class="tldw-filter-label">Search</label>
      <div class="tldw-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color:#7c8a99"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="tldw-search-input" placeholder="Search by topic, name, or keyword&hellip;" aria-label="Search meeting summaries">
      </div>

      <button type="button" class="tldw-filter-toggle" id="type-toggle" aria-expanded="false" aria-controls="type-pills">
        <span class="tldw-filter-label-text">Meeting type <span class="tldw-filter-summary" id="type-summary">All</span></span>
        <span class="tldw-caret" id="type-caret">+</span>
      </button>
      <div class="tldw-pill-row" id="type-pills" hidden>
        <button type="button" class="tldw-pill is-active" data-category="All">All ({meetings.length})</button>
        {categories.map((c) => (
          <button type="button" class="tldw-pill" data-category={c}>{c} ({categoryCounts[c]})</button>
        ))}
      </div>

      <button type="button" class="tldw-filter-toggle" id="topics-toggle" aria-expanded="false" aria-controls="topic-chips">
        <span class="tldw-filter-label-text">Topics <span class="tldw-filter-summary" id="topics-summary">All</span></span>
        <span class="tldw-caret" id="topics-caret">+</span>
      </button>
      <div class="tldw-chip-row" id="topic-chips" hidden>
        {topicList.map((t) => (
          <button type="button" class="tldw-chip" data-topic={t}>{t}</button>
        ))}
      </div>

      <div class="tldw-filter-footer">
        <span class="tldw-result-count"><span id="result-count">{meetings.length}</span> of {meetings.length} meetings <button type="button" class="tldw-clear" id="clear-filters" hidden>Clear filters</button></span>
        <div class="tldw-view-toggle">
          <button type="button" class="is-active" id="view-card">Cards</button>
          <button type="button" id="view-compact">Compact</button>
        </div>
      </div>

      <div class="tldw-legend">
        <span class="tldw-legend-label">&#128293;&nbsp;Feisty</span>
        <span class="tldw-legend-sep">&#9474;</span>
        <span>marks a meeting with a split or failed vote, or real floor debate, even when the final vote was unanimous.</span>
      </div>
    </div>

    <div id="tldw-list">
      {monthGroups.map((group) => (
        <section class="tldw-month-group" data-month={group.month}>
          <h2 class="tldw-month-head">{group.month}</h2>

          {group.items.map((m: any) => (
            <div
              class="mc-item"
              data-category={m.category}
              data-topics={m.topics.join('|')}
              data-search={[m.title, m.blurb, ...m.tags, ...m.topics, m.category].join(' ').toLowerCase()}
            >
              <a class="meeting-card mc-full" href={cardHref(m)} target={m.slug === '2026-10-19-special-meeting' ? undefined : '_blank'} rel={m.slug === '2026-10-19-special-meeting' ? undefined : 'noopener noreferrer'}>
                <div class="mc-top">
                  <span class="mc-type-badge" data-cat={m.category}>{m.category}</span>
                  <span class="mc-date">{m.dateLabel}</span>
                  {m.hot && <span class="hot-badge">&#128293;&nbsp;Feisty</span>}
                </div>
                <strong>{m.title}</strong>
                <span class="blurb">{m.blurb}</span>
                <div class="tldw-tags">
                  {m.topics.map((t: string) => <span class="tldw-tag">{t}</span>)}
                </div>
                <span class="mc-go">{cardCta(m)}</span>
              </a>

              <a class="mc-compact" href={cardHref(m)} target={m.slug === '2026-10-19-special-meeting' ? undefined : '_blank'} rel={m.slug === '2026-10-19-special-meeting' ? undefined : 'noopener noreferrer'}>
                <span class="mcc-date">{m.dateLabel}</span>
                <span class="mcc-type-badge" data-cat={m.category}>{m.category.replace('Committee of the Whole', 'CoW').replace(' Meeting', '').replace('Planning Board', 'PB')}</span>
                <span class="mcc-title">{m.title}</span>
                {m.hot && <span class="mcc-hot">&#128293;</span>}
              </a>
            </div>
          ))}
        </section>
      ))}
    </div>

    <p id="tldw-empty" class="tldw-empty">No meetings match these filters yet.</p>

    <div class="more-soon">More meetings added as summaries are finished.</div>

    <div class="disclaimer">
      <strong>Not a replacement for watching.</strong> Summarizing necessarily condenses and selects. For complete context and nuance, watch the full meeting video &mdash; the link is always right there when you want it.
    </div>
  </main>

  <script>
    const input = document.querySelector<HTMLInputElement>('#tldw-search-input');
    const items = Array.from(document.querySelectorAll<HTMLElement>('#tldw-list .mc-item'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('#tldw-list .tldw-month-group'));
    const empty = document.querySelector<HTMLElement>('#tldw-empty');
    const resultCount = document.querySelector<HTMLElement>('#result-count');
    const clearBtn = document.querySelector<HTMLButtonElement>('#clear-filters');
    const list = document.querySelector<HTMLElement>('#tldw-list');

    const typePills = Array.from(document.querySelectorAll<HTMLButtonElement>('#type-pills .tldw-pill'));
    const topicChips = Array.from(document.querySelectorAll<HTMLButtonElement>('#topic-chips .tldw-chip'));
    const typeSummary = document.querySelector<HTMLElement>('#type-summary');
    const topicsSummary = document.querySelector<HTMLElement>('#topics-summary');

    let selectedCategory = 'All';
    const selectedTopics = new Set<string>();

    function applyFilters() {
      const q = (input?.value ?? '').trim().toLowerCase();
      let visible = 0;

      items.forEach((item) => {
        const categoryOk = selectedCategory === 'All' || item.dataset.category === selectedCategory;
        const itemTopics = (item.dataset.topics ?? '').split('|');
        const topicsOk = selectedTopics.size === 0 || Array.from(selectedTopics).every((t) => itemTopics.includes(t));
        const searchOk = !q || (item.dataset.search ?? '').includes(q);
        const match = categoryOk && topicsOk && searchOk;
        item.style.display = match ? '' : 'none';
        if (match) visible += 1;
      });

      groups.forEach((group) => {
        const hasVisible = Array.from(group.querySelectorAll<HTMLElement>('.mc-item')).some((item) => item.style.display !== 'none');
        group.style.display = hasVisible ? '' : 'none';
      });

      if (resultCount) resultCount.textContent = String(visible);
      empty?.classList.toggle('show', visible === 0);

      const hasActiveFilters = selectedCategory !== 'All' || selectedTopics.size > 0 || q.length > 0;
      if (clearBtn) clearBtn.hidden = !hasActiveFilters;
    }

    typePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        selectedCategory = pill.dataset.category ?? 'All';
        typePills.forEach((p) => p.classList.toggle('is-active', p === pill));
        if (typeSummary) typeSummary.textContent = selectedCategory;
        applyFilters();
      });
    });

    topicChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const topic = chip.dataset.topic ?? '';
        if (selectedTopics.has(topic)) selectedTopics.delete(topic); else selectedTopics.add(topic);
        chip.classList.toggle('is-active', selectedTopics.has(topic));
        if (topicsSummary) {
          const n = selectedTopics.size;
          topicsSummary.textContent = n === 0 ? 'All' : n <= 2 ? Array.from(selectedTopics).join(', ') : `${n} selected`;
        }
        applyFilters();
      });
    });

    input?.addEventListener('input', applyFilters);

    clearBtn?.addEventListener('click', () => {
      selectedCategory = 'All';
      selectedTopics.clear();
      if (input) input.value = '';
      typePills.forEach((p) => p.classList.toggle('is-active', p.dataset.category === 'All'));
      topicChips.forEach((c) => c.classList.remove('is-active'));
      if (typeSummary) typeSummary.textContent = 'All';
      if (topicsSummary) topicsSummary.textContent = 'All';
      applyFilters();
    });

    function wireToggle(toggleId: string, panelId: string, caretId: string) {
      const toggle = document.querySelector<HTMLButtonElement>(`#${toggleId}`);
      const panel = document.querySelector<HTMLElement>(`#${panelId}`);
      const caret = document.querySelector<HTMLElement>(`#${caretId}`);
      toggle?.addEventListener('click', () => {
        const willOpen = panel?.hidden ?? false;
        if (panel) panel.hidden = !willOpen;
        toggle.setAttribute('aria-expanded', String(willOpen));
        if (caret) caret.textContent = willOpen ? '−' : '+';
      });
    }
    wireToggle('type-toggle', 'type-pills', 'type-caret');
    wireToggle('topics-toggle', 'topic-chips', 'topics-caret');

    const viewCardBtn = document.querySelector<HTMLButtonElement>('#view-card');
    const viewCompactBtn = document.querySelector<HTMLButtonElement>('#view-compact');
    viewCardBtn?.addEventListener('click', () => {
      list?.classList.remove('view-compact');
      viewCardBtn.classList.add('is-active');
      viewCompactBtn?.classList.remove('is-active');
    });
    viewCompactBtn?.addEventListener('click', () => {
      list?.classList.add('view-compact');
      viewCompactBtn.classList.add('is-active');
      viewCardBtn?.classList.remove('is-active');
    });
  </script>
</SiteLayout>
