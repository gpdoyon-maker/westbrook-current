---
// HTML version of a TL;DW! meeting summary. Content comes from
// src/data/tldw-summaries/<slug>.json, the master copy of each summary.
// Readers save or print this page; there is no separate PDF.
import SiteLayout from '../../layouts/SiteLayout.astro';
import meetings from '../../data/tldw-meetings.json';
import '../../styles/tldw.css';

export function getStaticPaths() {
  const files = import.meta.glob('../../data/tldw-summaries/*.json', { eager: true }) as Record<string, any>;
  return Object.values(files)
    .map((m: any) => m.default)
    .filter((d: any) => d.slug !== '2026-10-19-special-meeting') // that page is hand-built
    .map((d: any) => ({ params: { slug: d.slug }, props: { data: d } }));
}

const { data } = Astro.props as { data: any };
const meeting: any = (meetings as any[]).find((m) => m.slug === data.slug) || {};
const f = data.fields || {};
const videoUrl: string = f.Video || '';

// A decision line is "split" if it says a vote failed, or states a X–Y tally where Y > 0
// (a dissent/opposition). Numbers are bounded to 1–2 digits with word boundaries so an
// order number like "2026-120" or "26-000123" never matches as a fake tally.
function isSplitDecision(text: string) {
  if (/\bfailed\b/i.test(text)) return true;
  const m = text.match(/\b(\d{1,2})\b\s*[–‒-]\s*\b(\d{1,2})\b/);
  return !!m && Number(m[2]) > 0;
}

function tsLink(ts: string) {
  const parts = ts.split(':').map(Number);
  const [h, m, s] = parts.length === 3 ? parts : [0, parts[0], parts[1]];
  const frag = (h ? `${h}h` : '') + `${m}m${String(s).padStart(2, '0')}s`;
  return `${videoUrl}#t=${frag}`;
}
// Split text so "[12:34]" becomes a link and everything else stays plain (escaped) text.
function parts(text: string) {
  return text.split(/(\[\d{1,2}:\d{2}(?::\d{2})?\])/).filter(Boolean).map((t) => {
    const m = t.match(/^\[(\d{1,2}:\d{2}(?::\d{2})?)\]$/);
    return m ? { ts: m[1] } : { text: t };
  });
}

// Group blocks: section heads, and one collapsible item per timestamped heading.
type Item = { kind: 'item'; title: string; ts: string; body: any[] };
type Section = { kind: 'section'; title: string };
const rows: (Item | Section)[] = [];
const bl: any[] = data.blocks;
let cur: Item | null = null;
for (let i = 0; i < bl.length; i++) {
  const b = bl[i];
  if (b.t === 'h') {
    const next = bl[i + 1];
    const isSection = !b.ts && (/^[IVX]+[.–]/.test(b.x) || !cur || (next && next.t === 'h' && next.ts) || !next);
    if (b.ts) {
      cur = { kind: 'item', title: b.x, ts: b.ts, body: [] };
      rows.push(cur);
    } else if (isSection) {
      cur = null;
      rows.push({ kind: 'section', title: b.x });
    } else if (cur) {
      cur.body.push({ t: 'sub', x: b.x });
    }
    continue;
  }
  if (!cur) {
    cur = { kind: 'item', title: 'Overview', ts: '', body: [] };
    rows.push(cur);
  }
  cur.body.push(b);
}
// drop empty "None." action lists and the redundant "Discussion Summary" / "Key Decisions" labels
function cleaned(body: any[]) {
  const out: any[] = [];
  for (let i = 0; i < body.length; i++) {
    const b = body[i];
    if (b.t === 'label') {
      if (b.x === 'Action Items') {
        const rest: any[] = [];
        let j = i + 1;
        while (j < body.length && (body[j].t === 'a' || (body[j].t === 'p' && body[j].x === 'None.'))) {
          if (body[j].t === 'a') rest.push(body[j]);
          j++;
        }
        if (rest.length) out.push({ t: 'sub', x: rest.length === 1 ? 'Action item' : 'Action items' }, ...rest);
        i = j - 1;
      }
      continue;
    }
    out.push(b);
  }
  return out;
}
function brief(body: any[]) {
  const p = body.find((b) => b.t === 'p');
  if (!p) return '';
  const s = p.x.replace(/\[\d{1,2}:\d{2}(?::\d{2})?\]\s*/g, '');
  // first sentence, without stopping at abbreviations like "Dr.", "Sept." or "M.R.S.A."
  const abbr = /(?:\b(?:Dr|Mr|Mrs|Ms|St|Jr|Sr|Sen|Rep|Gov|No|vs|etc|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec|Dept|Mon|Tue|Tues|Wed|Thu|Thurs|Fri|Sat|Sun|sq|ft|approx)|\b[A-Z]|\.[A-Z])\.$/;
  const pieces = s.split(/(?<=[.!?])\s+/);
  let first = pieces[0];
  for (let i = 1; i < pieces.length && abbr.test(first); i++) first += ' ' + pieces[i];
  return first.length > 150 ? first.slice(0, 147).trimEnd() + '…' : first;
}

const dateLabel = meeting.dateLabel || f.Date || '';
const category = meeting.category || '';
const heading = `${(data.title || '').split(' — ')[0]} — ${f.Date ? f.Date.replace(/^\w+day,\s*/, '') : dateLabel}`;
const metaBits = [f.Location, f.Time && f.Time.replace(/\s*\(.*\)$/, '')].filter(Boolean);
const pageTitle = `TL;DW! ${heading} | Westbrook Currents`;

// Meeting-specific context (attendance, "no votes were taken") stored in the note, minus
// the standard disclaimer sentences that already appear at the bottom of the page.
const noteBoilerplate = ['This summary highlights', 'Summarization necessarily', 'For complete context', '(Produced by', 'This is produced', 'For the official', 'Unofficial'];
const meetingNote = (data.note || '')
  .split(/(?<=[.!?)])\s+/)
  .filter((s: string) => s && !noteBoilerplate.some((b) => s.startsWith(b)))
  .join(' ');
---
<SiteLayout title={pageTitle} description={meeting.blurb || 'Plain-language summary of the meeting.'} currentPage="tldw">
  <main class="tldw-wrap">
    <div class="tldw-print-head">
      <img src="/logo-desktop.webp" alt="Westbrook Currents" />
      <span>TL;DW! meeting summary · westbrookcurrents.com/tldw/{data.slug}</span>
    </div>
    <a class="help-back" href="/tldw">&#8249; TL;DW!</a>
    {category && <span class="tldw-eyebrow">{category}</span>}
    <h1>{heading}</h1>
    <p class="tldw-meta">{metaBits.join(' · ')}</p>
    {data.attendance && <p class="tldw-attendance"><strong>Attendance:</strong> {data.attendance}</p>}

    {videoUrl && (
      <div class="tldw-video-box">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="#07749b" stroke-width="2"><rect x="2" y="5" width="15" height="14" rx="2"></rect><path d="M17 10l5-3v10l-5-3z"></path></svg>
        <a class="watch" href={videoUrl} target="_blank" rel="noopener noreferrer">Watch the full video on Vimeo &#8599;</a>
        {data.packetUrl && <a class="watch" href={data.packetUrl} target="_blank" rel="noopener noreferrer">Meeting packet{data.packetNote ? ` ${data.packetNote}` : ''} &#8599;</a>}
      </div>
    )}
    <p class="tldw-scrub-note">Each item shows a timestamp like <b>57:13</b> (minutes:seconds) or <b>1:52:13</b> (hours:minutes:seconds). Tap it to jump to that moment in the video.</p>

    <button class="tldw-print-btn" type="button">Save or print this summary</button>

    {(meeting.title || meeting.blurb) && <p class="intro-line">Quick read: {[meeting.title && `${meeting.title}.`, meeting.blurb].filter(Boolean).join(' ')}</p>}
    {meetingNote && <p class="tldw-meeting-note">{meetingNote}</p>}

    {rows.map((r) => r.kind === 'section' ? (
      <h2 class="tldw-section-head">{r.title}</h2>
    ) : (
      <div class="tldw-item-wrap">
      {r.ts && <a class="ti-ts" href={tsLink(r.ts)} target="_blank" rel="noopener noreferrer">{r.ts}</a>}
      <details class="tldw-item">
        <summary>
          <span class="ti-text">
            <span class="ti-title">{r.title}</span>
            {brief(r.body) && <span class="ti-brief">{brief(r.body)}</span>}
          </span>
          <span class="ti-chev" aria-hidden="true"></span>
        </summary>
        <div class="ti-body">
          {cleaned(r.body).map((b: any) => {
            if (b.t === 'p') return <p>{parts(b.x).map((s: any) => s.ts ? <a class="ts-link" href={tsLink(s.ts)} target="_blank" rel="noopener noreferrer">{s.ts}</a> : s.text)}</p>;
            if (b.t === 'sub') return <p class="label">{b.x}</p>;
            if (b.t === 'q') return <p class="tldw-quote">{b.x}<cite>&mdash; {b.cite}{b.ts && <> &middot; <a class="ts-link" href={tsLink(b.ts)} target="_blank" rel="noopener noreferrer">{b.ts}</a></>}</cite></p>;
            if (b.t === 'fc') return <aside class="tldw-factcheck" aria-label="Westbrook Currents fact check"><span class="fc-label">Independent fact check by Westbrook Currents</span><span class="fc-note">Added after the meeting from public records. This was not said at the meeting and does not come from the City.</span> {b.x}{b.links && b.links.length > 0 && <span class="fc-src"> {b.links.length > 1 ? 'Sources' : 'Source'}: {b.links.map((l: any, i: number) => <>{i > 0 && '; '}<a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a></>)}</span>}</aside>;
            if (b.t === 'd') { const split = isSplitDecision(b.x); return <span class={`tldw-decision${split ? ' split' : ''}`}>{split ? '✗' : '✓'} {parts(b.x).map((s: any) => s.ts ? <a class="ts-link" href={tsLink(s.ts)} target="_blank" rel="noopener noreferrer">{s.ts}</a> : s.text)}</span>; }
            if (b.t === 'a') return <ul><li>{b.x}</li></ul>;
            return null;
          })}
        </div>
      </details>
      </div>
    ))}

    <div class="disclaimer">
      <strong>Not a replacement for watching &mdash; and not an official record.</strong> This summary highlights the meeting's key discussions and decisions; it's not a substitute for watching the full meeting, and summarization necessarily condenses and selects. <strong>It's also an unofficial product of Westbrook Currents, an independent site &mdash; not the City of Westbrook &mdash; and may contain mistakes.</strong> For complete context or the official record, watch the full video or see the City's approved minutes.
    </div>
    {data.howMade && <p class="tldw-made-with">How this was made: {data.howMade.replace(/^This summary was produced from the meeting video/, 'Produced from the meeting video')}</p>}
  </main>
  <script is:inline>
    (() => {
      // Closed sections don't print, so open everything first and put it back afterward.
      const items = Array.from(document.querySelectorAll('details.tldw-item'));
      let saved = null;
      const openAll = () => {
        if (saved) return;
        saved = items.map((d) => d.open);
        items.forEach((d) => { d.open = true; });
      };
      const restore = () => {
        if (!saved) return;
        items.forEach((d, i) => { d.open = saved[i]; });
        saved = null;
      };
      window.addEventListener('beforeprint', openAll);
      window.addEventListener('afterprint', restore);
      document.querySelector('.tldw-print-btn')?.addEventListener('click', () => {
        openAll();
        window.print();
      });
    })();
  </script>
</SiteLayout>
