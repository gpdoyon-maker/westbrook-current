---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import GuideLink from '../../components/GuideLink.astro';
import HelpDisclaimer from '../../components/HelpDisclaimer.astro';
import data from '../../data/help-property-tax-rent-relief.json';
import type { HelpProgram } from '../../lib/help';
import '../../styles/help.css';

const programs = data.programs as HelpProgram[];
---
<SiteLayout
  title="Property Tax & Rent Relief in Westbrook, Maine | Westbrook Currents"
  description="Exemptions, credits and a tax-deferral loan for Westbrook, Maine homeowners and renters."
  currentPage="help"
>
  <main class="help-wrap t-proptax">
    <a class="help-back" href="/help">&#8249; Get Help</a>
    <h1>{data.title}</h1>
    <p class="help-sub">{data.intro}</p>
    <GuideLink topic="property-tax-rent-relief" />

    <div class="help-linkout">
      <strong style="color:var(--navy)">Behind on rent, or facing eviction?</strong> These programs are about reducing what you owe long-term &mdash; not catching up fast. See <a href="/help/housing">Housing</a> for rent arrears help, eviction prevention and emergency shelter.
    </div>

    <h2 class="sr-only">Programs</h2>
    {programs.map((program) => <ProgramCard program={program} checked={data.lastChecked} />)}

    <HelpDisclaimer />
  </main>
</SiteLayout>
