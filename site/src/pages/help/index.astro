---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HelpDisclaimer from '../../components/HelpDisclaimer.astro';
import heating from '../../data/help-heating.json';
import food from '../../data/help-food.json';
import electricity from '../../data/help-electricity.json';
import { formatCheckedDate } from '../../lib/help';
import '../../styles/help.css';
---
<SiteLayout
  title="Get Help in Westbrook, Maine | Westbrook Currents"
  description="Programs and services for Westbrook, Maine residents. We are starting with heat, electricity and food."
  currentPage="help"
>
  <main class="help-wrap">
    <a class="help-back" href="/">&#8249; Home</a>
    <h1>Get Help</h1>
    <p class="help-sub">Programs that may help Westbrook residents.</p>

    <a class="topic-row t-heat" href="/help/heating">
      <strong>Heating &amp; Fuel</strong>
      <span>Help paying for heating oil, propane and other heat.</span>
      <em>Last checked {formatCheckedDate(heating.lastChecked)}</em>
      <span class="topic-go">See the steps &#8594;</span>
    </a>

    <a class="topic-row t-elec" href="/help/electricity">
      <strong>Electricity</strong>
      <span>Help with your electric bill, payment plans and winter shutoff rules.</span>
      <em>Last checked {formatCheckedDate(electricity.lastChecked)}</em>
      <span class="topic-go">See the steps &#8594;</span>
    </a>

    <a class="topic-row t-food" href="/help/food">
      <strong>Food</strong>
      <span>Food pantries, SNAP, WIC and meals for seniors.</span>
      <em>Last checked {formatCheckedDate(food.lastChecked)}</em>
      <span class="topic-go">See the steps &#8594;</span>
    </a>

    <a class="guide-row" href="/westbrook-currents-help-guide.pdf" target="_blank" rel="noopener noreferrer">
      <strong>Printable Help Guide (PDF)</strong>
      <span>All three topics in one file, to print or save.</span>
      <span class="topic-go">Open the guide &#8599;</span>
      <span class="ext-note">(PDF, opens in a new tab)</span>
    </a>

    <HelpDisclaimer />
  </main>
</SiteLayout>
