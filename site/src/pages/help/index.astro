---
import SiteLayout from '../../layouts/SiteLayout.astro';
import heating from '../../data/help-heating.json';
import food from '../../data/help-food.json';
import electricity from '../../data/help-electricity.json';
import housing from '../../data/help-housing.json';
import propertyTax from '../../data/help-property-tax-rent-relief.json';
import { formatCheckedDate } from '../../lib/help';
import '../../styles/help.css';
---
<SiteLayout
  title="Get Help in Westbrook, Maine | Westbrook Currents"
  description="Programs and services for Westbrook, Maine residents. We are starting with heat, electricity and food."
  currentPage="help"
>
  <main class="help-wrap">
    <a class="help-back" href="/">&#8249; Home</a>
    <h1>Get Help</h1>
    <p class="help-sub">Programs that may help Westbrook residents.</p>

    <a class="topic-row t-heat" href="/help/heating">
      <strong>Heating &amp; Fuel</strong>
      <span>Help paying for heating oil, propane and other heat.</span>
      <em>Last checked {formatCheckedDate(heating.lastChecked)}</em>
      <span class="topic-go">See the steps &#8594;</span>
    </a>

    <a class="topic-row t-elec" href="/help/electricity">
      <strong>Electricity</strong>
      <span>Help with your electric bill, payment plans and winter shutoff rules.</span>
      <em>Last checked {formatCheckedDate(electricity.lastChecked)}</em>
      <span class="topic-go">See the steps &#8594;</span>
    </a>

    <a class="topic-row t-food" href="/help/food">
      <strong>Food</strong>
      <span>Food pantries, SNAP, WIC and meals for seniors.</span>
      <em>Last checked {formatCheckedDate(food.lastChecked)}</em>
      <span class="topic-go">See the steps &#8594;</span>
    </a>

    <div class="topic-row-wrap">
      <span class="new-pill" data-new-until="2026-11-04" style="background:#7a3b66">New</span>
      <a class="topic-row t-house" href="/help/housing">
        <strong>Housing</strong>
        <span>Facing eviction, behind on rent, no place to stay, or looking for a voucher.</span>
        <em>Last checked {formatCheckedDate(housing.lastChecked)}</em>
        <span class="topic-go">See the steps &#8594;</span>
      </a>
    </div>

    <div class="topic-row-wrap">
      <span class="new-pill" data-new-until="2026-11-04" style="background:#0f6e6e">New</span>
      <a class="topic-row t-proptax" href="/help/property-tax-rent-relief">
        <strong>Property Tax &amp; Rent Relief</strong>
        <span>Exemptions, credits and a tax-deferral loan for homeowners and renters.</span>
        <em>Last checked {formatCheckedDate(propertyTax.lastChecked)}</em>
        <span class="topic-go">See the steps &#8594;</span>
      </a>
    </div>

  </main>

  <script>
    // "New" pills carry their own expiry date, so a topic stops looking new on its own —
    // no need to remember to come back and remove the badge by hand.
    document.querySelectorAll<HTMLElement>('.new-pill[data-new-until]').forEach((pill) => {
      const until = new Date(`${pill.dataset.newUntil}T23:59:59`);
      if (new Date() > until) pill.remove();
    });
  </script>
</SiteLayout>
