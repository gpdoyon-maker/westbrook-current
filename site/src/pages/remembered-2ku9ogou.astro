---
// Maine Veterans Remembered: an unlisted page for Gerry's Air National Guard retiree group.
// Not linked from any menu, kept out of the sitemap (astro.config.mjs) and search (privatePage).
// The list loads in the visitor's browser from the Veterans.gs web app, which sends only Approved rows.
import SiteLayout from '../layouts/SiteLayout.astro';
import { VETERANS_ENDPOINT } from '../lib/veterans-config';
---

<SiteLayout title="Maine Veterans Remembered | Westbrook Currents" description="Recent obituaries of Maine veterans." privatePage={true}>
  <div id="vr-config" data-endpoint={VETERANS_ENDPOINT} hidden></div>

  <main class="vr">
    <h1>Maine Veterans Remembered</h1>
    <p class="vr-intro">Recent obituaries of Maine veterans, newest first. Tap “Read obituary” to see the full notice. In Compact view, tap a name to see more.</p>
    <p class="vr-updated" id="vr-updated" hidden></p>
    <p class="vr-tally" id="vr-tally" hidden><span class="vr-tally-n" id="vr-tally-n"></span> <span class="vr-tally-t"><span id="vr-tally-t"></span><span class="visually-hidden">. </span><small id="vr-tally-s"></small></span></p>

    <div class="vr-toggle" role="group" aria-label="Who to show" id="vr-toggle" hidden>
      <button type="button" aria-pressed="true" data-filter="all">All veterans (<span id="vr-n-all">0</span>)</button>
      <button type="button" aria-pressed="false" data-filter="guard">Guard only (<span id="vr-n-guard">0</span>)</button>
    </div>

    <div class="vr-view" id="vr-view" hidden>
      <span class="vr-view-label" id="vr-view-label">Show as</span>
      <div class="vr-view-btns" role="group" aria-labelledby="vr-view-label">
        <button type="button" aria-pressed="true" data-view="cards">Cards</button>
        <button type="button" aria-pressed="false" data-view="compact">Compact</button>
      </div>
    </div>

    <p class="vr-status" id="vr-status" role="status">Loading the list…</p>
    <div id="vr-list"></div>

    <section class="vr-foot" aria-label="About this page">
      <p class="vr-private">This page is not listed on the website. Please share the link only with your group.</p>
      <p>Information comes from public obituaries posted by Maine newspapers and funeral homes. We may miss some. See something wrong or missing? <a href="/feedback">Tell us</a>.</p>
      <p>ANG = Air National Guard. ARNG = Army National Guard.</p>
    </section>
  </main>
</SiteLayout>

<!-- Global (all selectors start with .vr) because the cards are built in the browser, where scoped styles do not reach. -->
<style is:global>
  .vr { width: min(640px, 100%); margin: 0 auto; padding: 20px 16px 8px; }
  .vr h1 { margin: 4px 0 6px; color: var(--navy); font-size: 1.75rem; line-height: 1.2; }
  .vr-intro { margin: 0 0 6px; color: var(--muted); font-size: 1.0625rem; line-height: 1.45; }
  .vr-updated { margin: 0 0 14px; color: var(--muted); font-size: .9375rem; }
  .vr-tally { display: flex; align-items: center; gap: 14px; margin: 0 0 18px; padding: 12px 16px; border-left: 5px solid var(--navy); border-radius: 8px; background: var(--mist); }
  .vr-tally[hidden] { display: none; }
  .vr-tally-n { color: var(--navy); font-size: 2.25rem; font-weight: 700; line-height: 1; }
  .vr-tally-t { line-height: 1.35; }
  .vr-tally-t small { display: block; color: var(--muted); font-size: .875rem; }
  .vr-toggle { display: flex; margin-bottom: 18px; overflow: hidden; border: 2px solid var(--navy); border-radius: 10px; }
  .vr-toggle[hidden] { display: none; }
  .vr-toggle button { flex: 1; min-height: 48px; padding: 6px 8px; border: 0; color: var(--navy); background: #fff; font-size: 1rem; font-weight: 700; }
  .vr-toggle button[aria-pressed='true'] { color: #fff; background: var(--navy); }
  .vr-toggle button:focus-visible { outline: 3px solid var(--blue); outline-offset: -5px; }
  .vr-view { display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin: -6px 0 14px; }
  .vr-view[hidden] { display: none; }
  .vr-view-label { color: var(--muted); font-size: .9375rem; font-weight: 700; }
  .vr-view-btns { display: flex; gap: 4px; padding: 3px; border-radius: 8px; background: var(--line); }
  .vr-view-btns button { min-height: 40px; padding: 6px 14px; border: 0; border-radius: 6px; color: var(--navy); background: transparent; font-size: .9375rem; font-weight: 700; }
  .vr-view-btns button[aria-pressed='true'] { background: #fff; }
  .vr-view-btns button:focus-visible { outline: 3px solid var(--blue); outline-offset: 1px; }
  details.vr-row { margin: 0 0 8px; border: 1px solid var(--line); border-left: 5px solid var(--navy); border-radius: 8px; background: var(--mist); }
  details.vr-row[open] { border-color: #9aa8b2; background: #fff; }
  details.vr-row > summary { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 8px 12px; list-style: none; cursor: pointer; }
  details.vr-row > summary::-webkit-details-marker { display: none; }
  details.vr-row > summary:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .vr-row-main { display: flex; flex: 1; flex-wrap: wrap; align-items: center; gap: 6px 10px; min-width: 0; }
  .vr-row .vr-chips { margin: 0; }
  .vr-row-name { color: #092c43; font-size: 1.0625rem; font-weight: 700; line-height: 1.3; }
  .vr-chev { flex: none; color: var(--blue); font-size: 1.375rem; font-weight: 800; line-height: 1; }
  .vr-chev::before { content: '+'; }
  details.vr-row[open] .vr-chev { color: var(--navy); }
  details.vr-row[open] .vr-chev::before { content: '\2212'; }
  .vr-row-body { padding: 10px 12px 12px; border-top: 1px solid var(--line); }
  .vr-status { margin: 0 0 16px; padding: 14px 16px; border: 1px dashed var(--line); border-radius: 10px; color: var(--muted); background: #fff; }
  .vr-status:empty { display: none; }
  .vr h2 { margin: 8px 0 10px; padding-bottom: 6px; border-bottom: 2px solid var(--line); color: var(--navy); font-size: 1.125rem; }
  .vr h2 .vr-count { color: var(--muted); font-size: .9375rem; font-weight: 400; }
  .vr-card { margin: 0 0 12px; padding: 14px 14px 12px; border: 1px solid var(--line); border-left: 5px solid var(--navy); border-radius: 10px; background: #fff; }
  /* Branch colors: left edge of each card/row follows the first branch listed. */
  .vr-card[data-branch], details.vr-row[data-branch] { border-left-color: var(--br, #6b7780); }
  [data-branch='army'] { --br: #221f20; }
  [data-branch='usmc'] { --br: #a6192e; }
  [data-branch='navy'] { --br: #00205b; }
  [data-branch='af'] { --br: #00308f; }
  [data-branch='cg'] { --br: #c8102e; }
  [data-branch='sf'] { --br: #2c3e50; }
  [data-branch='guard'] { --br: #b07800; }
  .vr-card h3 { margin: 0 0 2px; color: #092c43; font-size: 1.25rem; line-height: 1.25; }
  .vr-meta { margin: 0; color: var(--muted); font-size: 1rem; }
  .vr-died { margin: 2px 0 8px; font-weight: 700; }
  .vr-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 8px; padding: 0; list-style: none; }
  .vr-chips li { padding: 4px 10px; border-radius: 999px; color: #36434c; background: #e6eaed; font-size: .875rem; font-weight: 700; }
  .vr-chips li.br-army { color: #ffcc01; background: #221f20; }
  .vr-chips li.br-usmc { color: #fff; background: #a6192e; }
  .vr-chips li.br-navy { color: #fff; background: #00205b; }
  .vr-chips li.br-af { color: #fff; background: #00308f; }
  .vr-chips li.br-cg { color: #fff; background: #c8102e; }
  .vr-chips li.br-sf { color: #fff; background: #2c3e50; }
  .vr-chips li.br-guard { color: #6b4500; background: #fff2d6; }
  .vr-unit, .vr-svc { margin: 0 0 8px; }
  .vr-unit strong { color: #6b4500; }
  .vr-fh { margin: 0 0 10px; color: var(--muted); font-size: .9375rem; }
  .vr-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 48px; padding: 6px 12px; border: 2px solid var(--navy); border-radius: 8px; color: var(--navy); background: #fff; font-weight: 700; line-height: 1.2; text-align: center; text-decoration: none; }
  .vr-btn small { margin-top: 2px; font-size: .8125rem; font-weight: 400; }
  .vr-btn:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .vr-foot { margin: 20px 0 16px; color: var(--muted); font-size: .9375rem; }
  .vr-foot p { margin: 0 0 8px; }
  .vr-private { padding: 10px 12px; border-radius: 8px; color: var(--navy); background: var(--mist); }
</style>

<script>
  type Row = { name: string; age: number | null; died: string; branches: string[]; town: string; funeralHome: string; link: string; unit: string };

  const endpoint = (document.getElementById('vr-config') as HTMLElement).dataset.endpoint || '';
  const statusEl = document.getElementById('vr-status') as HTMLElement;
  const listEl = document.getElementById('vr-list') as HTMLElement;
  const toggleEl = document.getElementById('vr-toggle') as HTMLElement;
  const updatedEl = document.getElementById('vr-updated') as HTMLElement;
  let rows: Row[] = [];

  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const SHORT = ['Jan.', 'Feb.', 'March', 'April', 'May', 'June', 'July', 'Aug.', 'Sept.', 'Oct.', 'Nov.', 'Dec.'];
  const parts = (iso: string) => iso.split('-').map(Number);
  const dayText = (iso: string) => { const [y, m, d] = parts(iso); return `${SHORT[m - 1]} ${d}, ${y}`; };
  const isGuard = (r: Row) => r.branches.some((b) => /National Guard/i.test(b));

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  }

  // In Compact rows, Guard branches are shown short; screen readers still hear the full name.
  // Cards and opened rows spell them out.
  const SHORT_BRANCH: Record<string, string> = { 'air national guard': 'ANG', 'army national guard': 'ARNG' };

  // "U.S. Army" / "United States Air Force" show as "Army" / "Air Force"; the U.S. is understood.
  const plainBranch = (b: string) => b.replace(/^(U\.?\s?S\.?|United States)\s+/i, '').trim();
  // Branch -> color key. National Guard first so 'Air National Guard' isn't read as Air Force.
  const branchKey = (b: string) =>
    /coast guard/i.test(b) ? 'cg' : /national guard/i.test(b) ? 'guard' : /marine/i.test(b) ? 'usmc' :
    /space force/i.test(b) ? 'sf' : /air force|usaf/i.test(b) ? 'af' : /navy|naval/i.test(b) ? 'navy' : /army/i.test(b) ? 'army' : 'vet';
  const branchList = (r: Row) => { const b = r.branches.filter((x) => x !== 'Unknown').map(plainBranch).filter(Boolean); return b.length ? [...new Set(b)] : ['Veteran']; };

  function chipList(r: Row, useShort: boolean) {
    const chips = el('ul', 'vr-chips');
    chips.setAttribute('aria-label', 'Service');
    branchList(r).forEach((b) => {
      const li = el('li', `br-${branchKey(b)}`);
      const short = useShort ? SHORT_BRANCH[b.trim().toLowerCase()] : '';
      if (short) {
        li.title = b;
        const vis = el('span', '', short);
        vis.setAttribute('aria-hidden', 'true');
        li.append(vis, el('span', 'visually-hidden', b));
      } else {
        li.textContent = b;
      }
      chips.append(li);
    });
    return chips;
  }

  // Age, town, date, unit, funeral home and the obituary button: shared by cards and opened compact rows.
  function details(r: Row, parent: HTMLElement) {
    const meta = [r.age != null ? `Age ${r.age}` : '', r.town].filter(Boolean).join(' · ');
    if (meta) parent.append(el('p', 'vr-meta', meta));
    parent.append(el('p', 'vr-died', `Died ${dayText(r.died)}`));
    return () => {
      if (r.unit) {
        const u = el('p', 'vr-unit');
        u.append(el('strong', '', 'Unit: '), document.createTextNode(r.unit));
        parent.append(u);
      }
      if (r.funeralHome) parent.append(el('p', 'vr-fh', `Funeral home: ${r.funeralHome}`));
      if (r.link) {
        const btn = el('a', 'vr-btn');
        btn.href = r.link;
        btn.target = '_blank';
        btn.rel = 'noopener';
        btn.append(el('span', '', `Read obituary ↗`), el('small', '', '(opens in a new tab)'));
        btn.setAttribute('aria-label', `Read the obituary for ${r.name} (opens in a new tab)`);
        parent.append(btn);
      }
    };
  }

  function card(r: Row) {
    const a = el('article', 'vr-card');
    a.dataset.branch = branchKey(branchList(r)[0]);
    a.append(el('h3', '', r.name));
    const rest = details(r, a);
    a.append(chipList(r, false));
    rest();
    return a;
  }

  // Compact view: name and service; tap the line to open the rest (same +/− pattern as TL;DW! items).
  function row(r: Row) {
    const d = el('details', 'vr-row');
    d.dataset.branch = branchKey(branchList(r)[0]);
    const sum = el('summary');
    const main = el('span', 'vr-row-main');
    main.append(el('span', 'vr-row-name', r.name), chipList(r, true));
    const chev = el('span', 'vr-chev');
    chev.setAttribute('aria-hidden', 'true');
    sum.append(main, chev);
    const body = el('div', 'vr-row-body');
    const rest = details(r, body);
    if (branchList(r).some((b) => SHORT_BRANCH[b.trim().toLowerCase()])) {
      const sv = el('p', 'vr-svc');
      sv.append(el('strong', '', 'Service: '), document.createTextNode(branchList(r).join(', ')));
      body.append(sv);
    }
    rest();
    d.append(sum, body);
    return d;
  }

  let filterNow: 'all' | 'guard' = 'all';
  let viewNow: 'cards' | 'compact' = 'cards';

  function render(filter: 'all' | 'guard' = filterNow) {
    filterNow = filter;
    listEl.textContent = '';
    const shown = filter === 'guard' ? rows.filter(isGuard) : rows;
    if (!shown.length) {
      statusEl.textContent = filter === 'guard' ? 'No Guard members on the list right now.' : 'No one is on the list yet.';
      return;
    }
    statusEl.textContent = '';
    let month = '';
    let section: HTMLElement | null = null;
    shown.forEach((r) => {
      const [y, m] = parts(r.died);
      const key = `${y}-${m}`;
      if (key !== month) {
        month = key;
        const count = shown.filter((x) => x.died.startsWith(r.died.slice(0, 7))).length;
        section = el('section');
        const h = el('h2', '', `${MONTHS[m - 1]} ${y} `);
        h.append(el('span', 'vr-count', `· ${count}`));
        section.append(h);
        listEl.append(section);
      }
      section!.append(viewNow === 'compact' ? row(r) : card(r));
    });
  }

  toggleEl.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
    b.addEventListener('click', () => {
      toggleEl.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render(b.dataset.filter as 'all' | 'guard');
    });
  });

  const viewEl = document.getElementById('vr-view') as HTMLElement;
  viewEl.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
    b.addEventListener('click', () => {
      viewEl.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      viewNow = b.dataset.view as 'cards' | 'compact';
      render();
    });
  });

  async function load() {
    if (!endpoint) { statusEl.textContent = 'This list is not set up yet.'; return; }
    try {
      const res = await fetch(endpoint);
      const data = await res.json();
      if (!data.ok || !Array.isArray(data.rows)) throw new Error('bad data');
      rows = data.rows;
      (document.getElementById('vr-n-all') as HTMLElement).textContent = String(rows.length);
      (document.getElementById('vr-n-guard') as HTMLElement).textContent = String(rows.filter(isGuard).length);
      if (data.updated) {
        const n = Number(data.added) || 0;
        const day = dayText(data.updated);
        if (n > 0) {
          (document.getElementById('vr-tally-n') as HTMLElement).textContent = String(n);
          (document.getElementById('vr-tally-t') as HTMLElement).textContent = `${n === 1 ? 'veteran' : 'veterans'} added to this list on ${day}`;
          (document.getElementById('vr-tally-s') as HTMLElement).textContent = 'Checked for new obituaries twice a day';
          (document.getElementById('vr-tally') as HTMLElement).hidden = false;
        } else {
          updatedEl.textContent = `Last updated ${day}`;
          updatedEl.hidden = false;
        }
      }
      toggleEl.hidden = false;
      viewEl.hidden = false;
      render('all');
    } catch {
      statusEl.textContent = 'The list could not load. Please try again in a few minutes.';
    }
  }
  load();
</script>
