---
import '../styles/global.css';
import NoticeList from '../components/NoticeList.astro';

interface Props {
  title: string;
  description: string;
  currentPage?: 'home' | 'events' | 'help' | 'vote' | 'perceptions' | 'tldw' | 'about' | 'submit' | 'feedback';
  // Private pages (the email confirmation page) are hidden from search, send no referrer, and skip analytics.
  privatePage?: boolean;
  // Page-specific social share image (1200x630). Defaults to the site logo.
  image?: string;
}

const { title, description, currentPage = 'events', privatePage = false, image } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://westbrookcurrents.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL(image ?? '/logo-desktop.png', siteUrl).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#00243d" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="robots" content={privatePage ? 'noindex, nofollow' : 'index, follow'} />
    {privatePage && <meta name="referrer" content="no-referrer" />}
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Westbrook Currents logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Westbrook Currents logo" />
    {!privatePage && (
      <Fragment>
        <!-- Google tag (gtag.js) -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HLW97NLQT0"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-HLW97NLQT0');
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Westbrook Currents home">
          <img class="logo-desktop" src="/logo-desktop.webp" alt="Westbrook Currents" />
          <img class="logo-mobile" src="/logo-mobile.webp" alt="Westbrook Currents" />
        </a>
        <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="site-nav">&#9776;</button>
        <nav class="site-nav" id="site-nav" aria-label="Main navigation">
          <a href="/events" aria-current={currentPage === 'events' ? 'page' : undefined}>Events</a>
          <a href="/help" aria-current={currentPage === 'help' ? 'page' : undefined}>Get Help</a>
          <a href="/vote" aria-current={currentPage === 'vote' ? 'page' : undefined}>Voting</a>
          <a href="/perceptions" aria-current={currentPage === 'perceptions' ? 'page' : undefined}>Factual Perceptions</a>
          <a href="/tldw" aria-current={currentPage === 'tldw' ? 'page' : undefined}>TL;DW!<span class="new-pill nav-new-pill" data-new-until="2026-11-07">New</span></a>
          <a href="/about/" aria-current={currentPage === 'about' ? 'page' : undefined}>About</a>
          <a class="submit-event-link" href="/submit">Submit an event</a>
        </nav>
      </div>
    </header>
    <NoticeList kind="alerts" />
    <slot />
    <footer class="site-footer"><p>© 2026 Westbrook Currents — Local events, real connections.</p><a href="/submit">Submit an event</a><a href="/feedback">Feedback</a></footer>
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#site-nav');

      menuButton?.addEventListener('click', () => {
        const isOpen = navigation?.classList.toggle('is-open') ?? false;
        menuButton.setAttribute('aria-expanded', String(isOpen));
      });

      // "New" pills (nav or elsewhere) carry their own expiry date, so they stop looking new on their own.
      document.querySelectorAll<HTMLElement>('.new-pill[data-new-until]').forEach((pill) => {
        const until = new Date(`${pill.dataset.newUntil}T23:59:59`);
        if (new Date() > until) pill.remove();
      });
    </script>
  </body>
</html>
