---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentPage?: 'events' | 'about';
}

const { title, description, currentPage = 'events' } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://westbrookcurrents.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL('/logo-desktop.png', siteUrl).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#00243d" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Westbrook Currents logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Westbrook Currents logo" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Westbrook Currents home">
          <img class="logo-desktop" src="/logo-desktop.webp" alt="Westbrook Currents" />
          <img class="logo-mobile" src="/logo-mobile.webp" alt="Westbrook Currents" />
          <span class="tagline">Local events. Real Connections.</span>
        </a>
        <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="site-nav">&#9776;</button>
        <nav class="site-nav" id="site-nav" aria-label="Main navigation">
          <a href="/" aria-current={currentPage === 'events' ? 'page' : undefined}>Events</a>
          <a href="/about/" aria-current={currentPage === 'about' ? 'page' : undefined}>About</a>
          <a class="submit-event-link" href="https://forms.gle/JHi1DmXpAA9YGVcH6" target="_blank" rel="noopener">Submit an event</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer"><p>© 2026 Westbrook Currents — Local events, real connections.</p><a href="https://forms.gle/JHi1DmXpAA9YGVcH6" target="_blank" rel="noopener">Submit an event</a></footer>
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#site-nav');

      menuButton?.addEventListener('click', () => {
        const isOpen = navigation?.classList.toggle('is-open') ?? false;
        menuButton.setAttribute('aria-expanded', String(isOpen));
      });
    </script>
  </body>
</html>
